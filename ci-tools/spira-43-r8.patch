+func TestH3StopClosesClientConnectionOnTimeout(t *testing.T) {
+	router := web.NewRouter()
+	probe := &h3StuckProbe{entered: make(chan struct{}), release: make(chan struct{})}
+	router.Handle("GET", "/stuck", h3StuckHandler(probe))
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	server := startH3Server(t, router, cert, 20*time.Millisecond)
+	if server == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	addr := server.BoundUDPAddrForTest()
+	clientTLS := &tls.Config{RootCAs: pool, ServerName: "example.com", NextProtos: []string{"h3"}}
+	conn, err := quic.DialAddr(ctx, addr, clientTLS, &quic.Config{})
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+		return
+	}
+	defer func() {
+		if conn.Context().Err() == nil {
+			if err := conn.CloseWithError(0, ""); err != nil {
+				t.Errorf("close connection: %v", err)
+			}
+		}
+	}()
+	client := http3peer.NewClientConn(conn)
+	url := "https://" + addr + "/stuck"
+	err = func() error {
+		go group (ctx) {
+			go fetchH3Stuck(ctx, client, url)
+			go stopH3Stuck(ctx, server, probe)
+		}
+		return nil
+	}()
+	if err != nil {
+		t.Fatalf("drive: %v", err)
+		return
+	}
+	var stopErr error
+	probe.stopErr.WithLock(func(err *error) { stopErr = *err })
+	if !errors.Is(stopErr, context.DeadlineExceeded) || !errors.Is(stopErr, http3.ErrH3Shutdown) {
+		t.Fatalf("stop error = %v, want H3 shutdown deadline", stopErr)
+	}
+	select {
+	case <-conn.Context().Done():
+	case <-ctx.Done():
+		t.Fatal("client connection stayed open after the shutdown deadline")
+	}
+}
