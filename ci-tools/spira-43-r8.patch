-func (c *h3EarlyUDP) WriteTo(data []byte, addr net.Addr) (int, error) {
-	const longHeaderTypeBits = 0b10110000
-	const zeroRTTLongHeader = 0b10010000
-	n, err := c.PacketConn.WriteTo(data, addr)
-	if err == nil && n >= 5 && data[0]&longHeaderTypeBits == zeroRTTLongHeader &&
-		binary.BigEndian.Uint32(data[1:5]) == uint32(quic.Version1) {
-		c.markSent()
-	}
-	return n, err
-}
