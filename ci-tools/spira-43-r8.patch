+func TestStreamRejectsBadHandshakes(t *testing.T) {
+	out := make(chan error, 8)
+	srv := serveStreamTLS(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, err := websocket.ServeStream(w, r, websocket.Config{})
+		if err != nil {
+			reportStream(r, out, err)
+			return
+		}
+		if c == nil {
+			reportStream(r, out, err)
+			return
+		}
+		reportStream(r, out, nil)
+		if cerr := c.Close(); cerr != nil {
+			t.Errorf("stream close: %v", cerr)
+		}
+	}))
+	h := openH2TLS(t, srv)
+	requireExtendedConnect(t, h)
+	addr := srv.Listener.Addr().String()
+	cases := streamRejectCases()
+	for _, tc := range cases {
+		ctx, cancel := context.WithTimeout(t.Context(), 10 * time.Second)
+		id := h.nextID
+		h.sendHeaders(t, id, tc.fields(addr), true)
+		status, _ := h.readResponseHeaders(t, id)
+		if status != tc.want {
+			cancel()
+			t.Fatalf("case %s: status = %d, want %d", tc.name, status, tc.want)
+			return
+		}
+		var err error
+		select {
+		case err = <-out:
+		case <-ctx.Done():
+			cancel()
+			t.Fatalf("case %s: no handshake result", tc.name)
+			return
+		}
+		if !errors.Is(err, tc.fault) {
+			cancel()
+			t.Fatalf("case %s: error = %v, want %v", tc.name, err, tc.fault)
+			return
+		}
+		cancel()
+	}
+}
+
+func TestStreamRefusesHTTP1Connect(t *testing.T) {
+	srv := httptest.NewServer(streamEchoHandler(t, websocket.Config{}))
+	defer srv.Close()
+	addr := strings.TrimPrefix(srv.URL, "http://")
+	conn, r := dialRaw(t, addr)
+	if _, err := conn.Write([]byte("CONNECT /chat HTTP/1.1\r\nHost: " + addr + "\r\n\r\n")); err != nil {
+		t.Fatalf("write CONNECT: %v", err)
+		return
+	}
+	code, _ := readResponse(t, r)
+	if code != http.StatusBadRequest {
+		t.Fatalf("status = %d, want 400", code)
+		return
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatalf("peer close: %v", err)
+		return
+	}
+}
