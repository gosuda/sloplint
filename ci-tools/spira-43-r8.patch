+type streamRejectCase struct {
+	name   string
+	fields func(addr string) []h2field
+	want   int
+	fault  error
+}
+
+func rejectFields(protocol string, version string, origin string) func(string) []h2field {
+	return func(addr string) []h2field {
+		fields := []h2field{
+			{name: ":method", value: "CONNECT"},
+			{name: ":protocol", value: protocol},
+			{name: ":scheme", value: "https"},
+			{name: ":path", value: "/chat"},
+			{name: ":authority", value: addr},
+		}
+		if version != "" {
+			fields = append(fields, h2field{name: "sec-websocket-version", value: version})
+		}
+		if origin != "" {
+			fields = append(fields, h2field{name: "origin", value: origin})
+		}
+		return fields
+	}
+}
+
+func reportStream(r *http.Request, out chan error, err error) {
+	select {
+	case out <- err:
+	case <-r.Context().Done():
+	}
+}
+
+func streamRejectCases() []streamRejectCase {
+	return []streamRejectCase{
+		{name: "foreign protocol", fields: rejectFields("bogus", "13", ""), want: http.StatusNotImplemented, fault: websocket.ErrHandshakeFailed},
+		{name: "missing protocol", fields: noProtocolFields, want: http.StatusNotImplemented, fault: websocket.ErrHandshakeFailed},
+		{name: "wrong version", fields: rejectFields("websocket", "12", ""), want: http.StatusBadRequest, fault: websocket.ErrHandshakeFailed},
+		{name: "missing version", fields: rejectFields("websocket", "", ""), want: http.StatusBadRequest, fault: websocket.ErrHandshakeFailed},
+		{name: "foreign origin", fields: rejectFields("websocket", "13", "https://evil.example"), want: http.StatusForbidden, fault: websocket.ErrForbiddenOrigin},
+		{name: "wrong method", fields: getFields, want: http.StatusMethodNotAllowed, fault: websocket.ErrHandshakeFailed},
+		{name: "malformed subprotocol", fields: subprotocolFields("not a token"), want: http.StatusBadRequest, fault: websocket.ErrHandshakeFailed},
+		{name: "repeated subprotocol", fields: subprotocolFields("chat, chat"), want: http.StatusBadRequest, fault: websocket.ErrHandshakeFailed},
+	}
+}
+
+func subprotocolFields(offer string) func(string) []h2field {
+	return func(addr string) []h2field {
+		return []h2field{
+			{name: ":method", value: "CONNECT"},
+			{name: ":protocol", value: "websocket"},
+			{name: ":scheme", value: "https"},
+			{name: ":path", value: "/chat"},
+			{name: ":authority", value: addr},
+			{name: "sec-websocket-version", value: "13"},
+			{name: "sec-websocket-protocol", value: offer},
+		}
+	}
+}
+
+func noProtocolFields(addr string) []h2field {
+	return []h2field{
+		{name: ":method", value: "CONNECT"},
+		{name: ":authority", value: addr},
+		{name: "sec-websocket-version", value: "13"},
+	}
+}
+
+func getFields(addr string) []h2field {
+	return []h2field{
+		{name: ":method", value: "GET"},
+		{name: ":scheme", value: "https"},
+		{name: ":path", value: "/chat"},
+		{name: ":authority", value: addr},
+		{name: "sec-websocket-version", value: "13"},
+	}
+}
