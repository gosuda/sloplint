+func streamEchoHandler(t *testing.T, cfg websocket.Config) http.Handler {
+	t.Helper()
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, err := websocket.ServeStream(w, r, cfg)
+		if err != nil {
+			return
+		}
+		if c == nil {
+			t.Errorf("serve stream gave no connection")
+			return
+		}
+		defer func() {
+			if cerr := c.Close(); cerr != nil && !errors.Is(cerr, websocket.ErrClosed) {
+				t.Errorf("stream close: %v", cerr)
+			}
+		}()
+		ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+		defer cancel()
+		for {
+			k, payload, err := c.Next(ctx)
+			if err != nil {
+				if !errors.Is(err, websocket.ErrClosed) {
+					t.Errorf("stream next: %v", err)
+				}
+				return
+			}
+			if k == websocket.Close {
+				return
+			}
+			if k != websocket.Text {
+				continue
+			}
+			if werr := c.WriteText(ctx, payload); werr != nil {
+				t.Errorf("stream echo: %v", werr)
+				return
+			}
+		}
+	})
+}
+
+func serveStreamTLS(t *testing.T, handler http.Handler) *httptest.Server {
+	t.Helper()
+	srv := httptest.NewUnstartedServer(handler)
+	srv.EnableHTTP2 = true
+	srv.Config.EnableHTTP2ExtendedConnect()
+	srv.StartTLS()
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+type h2field struct {
+	name  string
+	value string
+}
+
+type h2entry struct {
+	name  string
+	value string
+}
+
+type h2frame struct {
+	ftype   uint8
+	flags   uint8
+	id      uint32
+	payload []byte
+}
+
+type h2client struct {
+	conn      net.Conn
+	reader    *bufio.Reader
+	nextID    uint32
+	dyn       []h2entry
+	data      []byte
+	ended     bool
+	advertised bool
+}
+
+func openH2(t *testing.T, conn net.Conn) *h2client {
+	t.Helper()
+	if err := conn.SetDeadline(time.Now().Add(20 * time.Second)); err != nil {
+		t.Fatalf("h2 deadline: %v", err)
+		panic("h2 deadline failed")
+	}
+	t.Cleanup(func() {
+		if err := conn.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
+			t.Errorf("h2 close: %v", err)
+		}
+	})
+	h := &h2client{conn: conn, reader: bufio.NewReader(conn), nextID: 1}
+	if _, err := conn.Write([]byte("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")); err != nil {
+		t.Fatalf("h2 preface: %v", err)
+		panic("h2 preface failed")
+	}
+	h.writeFrame(t, h2frame{ftype: 0x4})
+	for {
+		f, err := h.readFrame()
+		if err != nil {
+			t.Fatalf("h2 settings: %v", err)
+			panic("h2 settings failed")
+		}
+		if f.ftype == 0x4 && f.flags&0x1 == 0 {
+			h.advertised = hasConnectSetting(f.payload)
+			h.writeFrame(t, h2frame{ftype: 0x4, flags: 0x1})
+			return h
+		}
+	}
+}
+
+func hasConnectSetting(payload []byte) bool {
+	for len(payload) >= 6 {
+		id := uint16(payload[0])<<8 | uint16(payload[1])
+		value := uint32(payload[2])<<24 | uint32(payload[3])<<16 | uint32(payload[4])<<8 | uint32(payload[5])
+		if id == 0x8 && value == 1 {
+			return true
+		}
+		payload = payload[6:]
+	}
+	return false
+}
+
+func requireExtendedConnect(t *testing.T, h *h2client) {
+	t.Helper()
+	if !h.advertised {
+		t.Fatal("server did not advertise SETTINGS_ENABLE_CONNECT_PROTOCOL")
+	}
+}
+
+func openH2TLS(t *testing.T, srv *httptest.Server) *h2client {
+	t.Helper()
+	pool := x509.NewCertPool()
+	pool.AddCert(srv.Certificate())
+	conn, err := tls.Dial("tcp", srv.Listener.Addr().String(), &tls.Config{RootCAs: pool, ServerName: "example.com", NextProtos: []string{"h2"}})
+	if err != nil {
+		t.Fatalf("tls dial: %v", err)
+		panic("tls dial failed")
+	}
+	if got := conn.ConnectionState().NegotiatedProtocol; got != "h2" {
+		t.Fatalf("alpn = %q, want h2", got)
+		panic("alpn failed")
+	}
+	return openH2(t, conn)
+}
+
+func (h *h2client) writeFrame(t *testing.T, f h2frame) {
+	t.Helper()
+	var hdr [9]byte
+	n := len(f.payload)
+	hdr[0] = byte(n >> 16)
+	hdr[1] = byte(n >> 8)
+	hdr[2] = byte(n)
+	hdr[3] = f.ftype
+	hdr[4] = f.flags
+	hdr[5] = byte(f.id >> 24)
+	hdr[6] = byte(f.id >> 16)
+	hdr[7] = byte(f.id >> 8)
+	hdr[8] = byte(f.id)
+	if _, err := h.conn.Write(hdr[:]); err != nil {
+		t.Fatalf("h2 write header: %v", err)
+		panic("h2 write header failed")
+	}
+	if len(f.payload) == 0 {
+		return
+	}
+	if _, err := h.conn.Write(f.payload); err != nil {
+		t.Fatalf("h2 write payload: %v", err)
+		panic("h2 write payload failed")
+	}
+}
+func (h *h2client) readFrame() (h2frame, error) {
+	var hdr [9]byte
+	if _, err := io.ReadFull(h.reader, hdr[:]); err != nil {
+		return h2frame{}, err
+	}
+	n := int(hdr[0])<<16 | int(hdr[1])<<8 | int(hdr[2])
+	payload := make([]byte, n)
+	if _, err := io.ReadFull(h.reader, payload); err != nil {
+		return h2frame{}, err
+	}
+	id := uint32(hdr[5])<<24 | uint32(hdr[6])<<16 | uint32(hdr[7])<<8 | uint32(hdr[8])
+	id &= 0x7fffffff
+	return h2frame{ftype: hdr[3], flags: hdr[4], id: id, payload: payload}, nil
+}
+
+func (h *h2client) applyControl(t *testing.T, f h2frame) {
+	t.Helper()
+	if f.ftype == 0x4 && f.flags&0x1 == 0 {
+		h.writeFrame(t, h2frame{ftype: 0x4, flags: 0x1})
+		return
+	}
+	if f.ftype == 0x6 && f.flags&0x1 == 0 && len(f.payload) == 8 {
+		h.writeFrame(t, h2frame{ftype: 0x6, flags: 0x1, payload: f.payload})
+		return
+	}
+}
+
+func hpackAppendInt(dst []byte, prefix uint8, v uint64) []byte {
+	max := uint64(byte(1<<prefix) - 1)
+	if v < max {
+		return append(dst, byte(v))
+	}
+	dst = append(dst, byte(max))
+	v -= max
+	for v >= 128 {
+		dst = append(dst, byte(v&127)|128)
+		v >>= 7
+	}
+	return append(dst, byte(v))
+}
+
+func (h *h2client) sendHeaders(t *testing.T, id uint32, fields []h2field, endStream bool) {
+	t.Helper()
+	var block []byte
+	for _, f := range fields {
+		block = append(block, 0x00)
+		block = hpackAppendInt(block, 7, uint64(len(f.name)))
+		block = append(block, f.name...)
+		block = hpackAppendInt(block, 7, uint64(len(f.value)))
+		block = append(block, f.value...)
+	}
+	flags := uint8(0x4)
+	if endStream {
+		flags |= 0x1
+	}
+	h.writeFrame(t, h2frame{ftype: 0x1, flags: flags, id: id, payload: block})
+	h.nextID = id + 2
+	h.data = nil
+	h.ended = false
+}
+
+func (h *h2client) sendData(t *testing.T, id uint32, data []byte, endStream bool) {
+	t.Helper()
+	flags := uint8(0x0)
+	if endStream {
+		flags |= 0x1
+	}
+	h.writeFrame(t, h2frame{ftype: 0x0, flags: flags, id: id, payload: data})
+}
+
+func (h *h2client) nextHeaderFrame(t *testing.T, id uint32) h2frame {
+	t.Helper()
+	for {
+		f, err := h.readFrame()
+		if err != nil {
+			t.Fatalf("h2 read response: %v", err)
+			panic("h2 read response failed")
+		}
+		h.applyControl(t, f)
+		if f.ftype == 0x9 {
+			t.Fatal("h2 test client: fragmented headers")
+			panic("fragmented headers")
+		}
+		if f.ftype == 0x1 && f.id == id {
+			if f.flags&0x4 == 0 {
+				t.Fatal("h2 test client: headers without END_HEADERS")
+				panic("headers without END_HEADERS")
+			}
+			return f
+		}
+		if f.ftype == 0x3 || f.ftype == 0x7 {
+			t.Fatalf("h2 stream ended while reading headers: type %d", f.ftype)
+			panic("h2 stream ended")
+		}
+	}
+}
+
+func (h *h2client) readResponseHeaders(t *testing.T, id uint32) (int, []h2field) {
+	t.Helper()
+	f := h.nextHeaderFrame(t, id)
+	fields, err := h.decodeHeaders(f.payload)
+	if err != nil {
+		t.Fatalf("h2 decode headers: %v", err)
+		panic("h2 decode headers failed")
+	}
+	status, err := h2Status(fields)
+	if err != nil {
+		t.Fatalf("h2 response status: %v", err)
+		panic("h2 response status failed")
+	}
+	if f.flags&0x1 != 0 {
+		h.ended = true
+	}
+	return status, fields
+}
+
+func (h *h2client) fillWSData(t *testing.T, id uint32) bool {
+	t.Helper()
+	f, err := h.readFrame()
+	if err != nil {
+		t.Fatalf("h2 read ws frame: %v", err)
+		panic("h2 read ws frame failed")
+	}
+	h.applyControl(t, f)
+	if f.ftype == 0x0 && f.id == id {
+		h.data = append(h.data, f.payload...)
+		if f.flags&0x1 != 0 {
+			h.ended = true
+		}
+		return false
+	}
+	if f.ftype == 0x3 || f.ftype == 0x7 {
+		return true
+	}
+	return false
+}
+
+func (h *h2client) readWSFrame(t *testing.T, id uint32) (uint8, []byte, bool) {
+	t.Helper()
+	for {
+		op, pay, rest, ok, err := splitWSFrame(h.data)
+		if err != nil {
+			t.Fatalf("ws frame: %v", err)
+			panic("ws frame failed")
+		}
+		if ok {
+			h.data = rest
+			return op, pay, false
+		}
+		if h.ended {
+			return 0, nil, true
+		}
+		if h.fillWSData(t, id) {
+			return 0, nil, true
+		}
+	}
+}
+
+func splitWSFrame(data []byte) (uint8, []byte, []byte, bool, error) {
+	if len(data) < 2 {
+		return 0, nil, data, false, nil
+	}
+	if data[1]&0x80 != 0 {
+		return 0, nil, nil, false, errors.New("h2 test client: masked server frame")
+	}
+	length := int(data[1] & 0x7f)
+	head := 2
+	if length == 126 {
+		if len(data) < 4 {
+			return 0, nil, data, false, nil
+		}
+		length = int(data[2])<<8 | int(data[3])
+		head = 4
+	} else if length == 127 {
+		return 0, nil, nil, false, errors.New("h2 test client: 64-bit frame length")
+	}
+	if len(data) < head+length {
+		return 0, nil, data, false, nil
+	}
+	return data[0] & 0x0f, data[head : head+length], data[head+length:], true, nil
+}
+
+func wsMasked(b0 uint8, payload []byte) []byte {
+	key := [4]byte{0x37, 0xfa, 0x21, 0x3d}
+	out := []byte{b0, 0x80 | byte(len(payload)), key[0], key[1], key[2], key[3]}
+	for i, b := range payload {
+		out = append(out, b^key[i%4])
+	}
+	return out
+}
+
+func h2Status(fields []h2field) (int, error) {
+	for _, f := range fields {
+		if f.name == ":status" {
+			return strconv.Atoi(f.value)
+		}
+	}
+	return 0, errors.New("h2 test client: response without :status")
+}
+
+func h2HeaderValue(fields []h2field, name string) string {
+	for _, f := range fields {
+		if f.name == name {
+			return f.value
+		}
+	}
+	return ""
+}
+
+func hpackReadInt(data []byte, prefix uint8) (uint64, int, error) {
+	if len(data) == 0 {
+		return 0, 0, errors.New("h2 test client: short HPACK int")
+	}
+	var mask uint8
+	if prefix >= 8 {
+		mask = 0xff
+	} else {
+		mask = uint8(1<<prefix) - 1
+	}
+	v := uint64(data[0] & mask)
+	if v < uint64(mask) {
+		return v, 1, nil
+	}
+	var shift uint
+	used := 1
+	for {
+		if used >= len(data) {
+			return 0, 0, errors.New("h2 test client: short HPACK int")
+		}
+		b := data[used]
+		used++
+		v += uint64(b&127) << shift
+		shift += 7
+		if shift > 62 {
+			return 0, 0, errors.New("h2 test client: HPACK int too large")
+		}
+		if b&128 == 0 {
+			return v, used, nil
+		}
+	}
+}
+
+func hpackReadString(data []byte) (string, int, error) {
+	if len(data) == 0 {
+		return "", 0, errors.New("h2 test client: short HPACK string")
+	}
+	huffman := data[0]&128 != 0
+	ln, used, err := hpackReadInt(data, 7)
+	if err != nil {
+		return "", 0, err
+	}
+	if uint64(len(data)-used) < ln {
+		return "", 0, errors.New("h2 test client: short HPACK string")
+	}
+	raw := data[used : used+int(ln)]
+	if huffman {
+		s, err := huffDecode(raw)
+		if err != nil {
+			return "", 0, err
+		}
+		return s, used + int(ln), nil
+	}
+	return string(raw), used + int(ln), nil
+}
+
+func hpackIndexed(idx uint64, dyn []h2entry) (string, string, error) {
+	if idx >= 1 && idx <= 61 {
+		return hpackStaticName[idx-1], hpackStaticValue[idx-1], nil
+	}
+	if idx >= 62 && idx-62 < uint64(len(dyn)) {
+		e := dyn[len(dyn)-1-int(idx-62)]
+		return e.name, e.value, nil
+	}
+	return "", "", fmt.Errorf("h2 test client: bad HPACK index %d", idx)
+}
+
+func hpackName(idx uint64, dyn []h2entry) (string, error) {
+	name, _, err := hpackIndexed(idx, dyn)
+	if err != nil {
+		return "", err
+	}
+	return name, nil
+}
+
+func decodeLiteral(payload []byte, prefix uint8, insert bool, dyn []h2entry) (h2field, []byte, bool, error) {
+	idx, used, err := hpackReadInt(payload, prefix)
+	if err != nil {
+		return h2field{}, nil, false, err
+	}
+	rest := payload[used:]
+	var name string
+	if idx == 0 {
+		var m int
+		name, m, err = hpackReadString(rest)
+		if err != nil {
+			return h2field{}, nil, false, err
+		}
+		rest = rest[m:]
+	} else {
+		name, err = hpackName(idx, dyn)
+		if err != nil {
+			return h2field{}, nil, false, err
+		}
+	}
+	var value string
+	var m int
+	value, m, err = hpackReadString(rest)
+	if err != nil {
+		return h2field{}, nil, false, err
+	}
+	rest = rest[m:]
+	return h2field{name: name, value: value}, rest, insert, nil
+}
+
+func decodeOneField(payload []byte, dyn []h2entry) (h2field, []byte, bool, error) {
+	b := payload[0]
+	if b&128 != 0 {
+		idx, used, err := hpackReadInt(payload, 7)
+		if err != nil {
+			return h2field{}, nil, false, err
+		}
+		name, value, err := hpackIndexed(idx, dyn)
+		if err != nil {
+			return h2field{}, nil, false, err
+		}
+		return h2field{name: name, value: value}, payload[used:], false, nil
+	}
+	if b&0xc0 == 0x40 {
+		return decodeLiteral(payload, 6, true, dyn)
+	}
+	if b&0xe0 == 0x20 {
+		return h2field{}, nil, false, errors.New("h2 test client: dynamic table size update")
+	}
+	return decodeLiteral(payload, 4, false, dyn)
+}
+
+func (h *h2client) decodeHeaders(payload []byte) ([]h2field, error) {
+	var out []h2field
+	for len(payload) > 0 {
+		f, rest, insert, err := decodeOneField(payload, h.dyn)
+		if err != nil {
+			return nil, err
+		}
+		if insert {
+			h.dyn = append(h.dyn, h2entry{name: f.name, value: f.value})
+		}
+		out = append(out, f)
+		payload = rest
+	}
+	return out, nil
+}
+
+func huffDecode(src []byte) (string, error) {
+	var out []byte
+	var cur uint64
+	var n uint
+	for _, b := range src {
+		cur = cur<<8 | uint64(b)
+		n += 8
+		for {
+			sym, ln, ok := huffLookup(cur, n)
+			if !ok {
+				break
+			}
+			out = append(out, byte(sym))
+			if n == uint(ln) {
+				cur = 0
+			} else {
+				cur &= (uint64(1) << (n - uint(ln))) - 1
+			}
+			n -= uint(ln)
+		}
+	}
+	if n > 7 {
+		return "", errors.New("h2 test client: bad Huffman padding")
+	}
+	if n > 0 && cur != (uint64(1)<<n)-1 {
+		return "", errors.New("h2 test client: bad Huffman padding")
+	}
+	return string(out), nil
+}
+
+func huffLookup(cur uint64, n uint) (int, int, bool) {
+	for sym := 0; sym < 256; sym++ {
+		ln := int(huffLen[sym])
+		if ln == 0 || uint(ln) > n {
+			continue
+		}
+		mask := (uint64(1) << uint(ln)) - 1
+		if cur>>(n-uint(ln))&mask == uint64(huffCode[sym]) {
+			return sym, ln, true
+		}
+	}
+	return 0, 0, false
+}
+
+func streamConnectFields(addr string, subprotocol string) []h2field {
+	fields := []h2field{
+		{name: ":method", value: "CONNECT"},
+		{name: ":protocol", value: "websocket"},
+		{name: ":scheme", value: "https"},
+		{name: ":path", value: "/chat"},
+		{name: ":authority", value: addr},
+		{name: "sec-websocket-version", value: "13"},
+	}
+	if subprotocol != "" {
+		fields = append(fields, h2field{name: "sec-websocket-protocol", value: subprotocol})
+	}
+	return fields
+}
+
+func TestStreamEchoOverTLS(t *testing.T) {
+	srv := serveStreamTLS(t, streamEchoHandler(t, websocket.Config{Subprotocols: []string{"chat"}}))
+	h := openH2TLS(t, srv)
+	requireExtendedConnect(t, h)
+	addr := srv.Listener.Addr().String()
+	id := h.nextID
+	h.sendHeaders(t, id, streamConnectFields(addr, "chat"), false)
+	status, fields := h.readResponseHeaders(t, id)
+	if status != http.StatusOK {
+		t.Fatalf("extended CONNECT status = %d, want 200", status)
+		return
+	}
+	if got := h2HeaderValue(fields, "sec-websocket-protocol"); got != "chat" {
+		t.Fatalf("subprotocol = %q, want chat", got)
+		return
+	}
+	h.sendData(t, id, wsMasked(0x81, []byte("hello")), false)
+	op, echo, ended := h.readWSFrame(t, id)
+	if ended {
+		t.Fatal("stream ended before the echo")
+		return
+	}
+	if op != 0x1 {
+		t.Fatalf("echo opcode = %d, want 1", op)
+		return
+	}
+	if string(echo) != "hello" {
+		t.Fatalf("echo = %q, want hello", string(echo))
+		return
+	}
+	h.sendData(t, id, wsMasked(0x88, []byte{0x03, 0xe8}), false)
+	op, echo, ended = h.readWSFrame(t, id)
+	if ended {
+		t.Fatal("stream ended before the close echo")
+		return
+	}
+	if op != 0x8 {
+		t.Fatalf("close opcode = %d, want 8", op)
+		return
+	}
+	code, reason, err := websocket.ParseClose(echo)
+	if err != nil {
+		t.Fatalf("parse close: %v", err)
+		return
+	}
+	if code != 1000 || reason != "" {
+		t.Fatalf("close = %d %q, want 1000 empty", code, reason)
+		return
+	}
+	_, _, ended = h.readWSFrame(t, id)
+	if !ended {
+		t.Fatal("second server frame: want stream end, got a frame")
+		return
+	}
+}
+
+func streamCloseHandler(t *testing.T, done chan struct{}) http.Handler {
+	t.Helper()
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(done)
+		c, err := websocket.ServeStream(w, r, websocket.Config{})
+		if err != nil {
+			t.Errorf("serve stream: %v", err)
+			return
+		}
+		if c == nil {
+			t.Errorf("serve stream gave no connection")
+			return
+		}
+		defer func() {
+			if cerr := c.Close(); cerr != nil && !errors.Is(cerr, websocket.ErrClosed) {
+				t.Errorf("stream close: %v", cerr)
+			}
+		}()
+		ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+		defer cancel()
+		k, payload, err := c.Next(ctx)
+		if err != nil {
+			t.Errorf("first next: %v", err)
+			return
+		}
+		if k != websocket.Close {
+			t.Errorf("first kind = %d, want close", uint8(k))
+			return
+		}
+		code, reason, err := websocket.ParseClose(payload)
+		if err != nil {
+			t.Errorf("parse close: %v", err)
+			return
+		}
+		if code != 1000 || reason != "bye" {
+			t.Errorf("close = %d %q, want 1000 bye", code, reason)
+			return
+		}
+		if _, _, err := c.Next(ctx); !errors.Is(err, websocket.ErrClosed) {
+			t.Errorf("second next error = %v, want ErrClosed", err)
+			return
+		}
+	})
+}
+
+func TestStreamCloseRoundTrip(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 60 * time.Second)
+	defer cancel()
+	done := make(chan struct{})
+	srv := serveStreamTLS(t, streamCloseHandler(t, done))
+	h := openH2TLS(t, srv)
+	requireExtendedConnect(t, h)
+	addr := srv.Listener.Addr().String()
+	id := h.nextID
+	h.sendHeaders(t, id, streamConnectFields(addr, ""), false)
+	if status, _ := h.readResponseHeaders(t, id); status != http.StatusOK {
+		t.Fatalf("extended CONNECT status = %d, want 200", status)
+		return
+	}
+	h.sendData(t, id, wsMasked(0x88, []byte{0x03, 0xe8, 'b', 'y', 'e'}), false)
+	op, echo, ended := h.readWSFrame(t, id)
+	if ended {
+		t.Fatal("stream ended before the close echo")
+		return
+	}
+	if op != 0x8 {
+		t.Fatalf("close opcode = %d, want 8", op)
+		return
+	}
+	code, reason, err := websocket.ParseClose(echo)
+	if err != nil {
+		t.Fatalf("parse close: %v", err)
+		return
+	}
+	if code != 1000 || reason != "bye" {
+		t.Fatalf("close = %d %q, want 1000 bye", code, reason)
+		return
+	}
+	select {
+	case <-done:
+	case <-ctx.Done():
+		t.Fatal("stream handler did not end after the close round trip")
+		return
+	}
+}
