+type h3ConflictProbe struct {
+	server *http3.Server
+	packet net.PacketConn
+	result chan error
+}
+
+func startH3DuringConflict(ctx context.Context, p *h3ConflictProbe) error {
+	err := p.server.Start(ctx)
+	select {
+	case p.result <- err:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func releaseH3Conflict(ctx context.Context, p *h3ConflictProbe) error {
+	synctest.Wait()
+	select {
+	case err := <-p.result:
+		if err == nil {
+			return errors.New("start succeeded while the UDP port was occupied")
+		}
+		return fmt.Errorf("start returned before the UDP port was released: %w", err)
+	default:
+	}
+	if err := p.packet.Close(); err != nil {
+		return fmt.Errorf("release UDP port: %w", err)
+	}
+	select {
+	case err := <-p.result:
+		if err != nil {
+			return fmt.Errorf("start after UDP port release: %w", err)
+		}
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func driveTransientH3Start(ctx context.Context, p *h3ConflictProbe) error {
+	go group (ctx) {
+		go startH3DuringConflict(ctx, p)
+		go releaseH3Conflict(ctx, p)
+	}
+	return nil
+}
+
+func TestH3StartSucceedsAfterTransientUDPConflict(t *testing.T) {
