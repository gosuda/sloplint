-func wsMasked(b0 uint8, payload []byte) []byte {
-	key := [4]byte{0x37, 0xfa, 0x21, 0x3d}
-	out := []byte{b0, 0x80 | byte(len(payload)), key[0], key[1], key[2], key[3]}
-	for i, b := range payload {
-		out = append(out, b^key[i%4])
-	}
-	return out
-}
