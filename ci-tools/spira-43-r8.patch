+func TestH3StopDrainsWithinGrace(t *testing.T) {
+	r := web.NewRouter()
+	p := &h3SlowProbe{entered: make(chan struct{}), release: make(chan struct{})}
+	r.Handle("GET", "/slow", h3SlowHandler(p))
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	s := startH3Server(t, r, cert, 5*time.Second)
+	if s == nil {
+		t.Fatal("server did not start")
+		return
+	}
+	udpAddr := s.BoundUDPAddrForTest()
+	if udpAddr == "" {
+		t.Fatal("no UDP bound address")
+		return
+	}
+	tr := http3peer.NewTransport(&tls.Config{RootCAs: pool})
+	defer closeH3Transport(t, tr)
+	if err := driveH3Slow(context.Background(), h3Target{tr: tr, url: "https://"+udpAddr+"/slow"}, s, p); err != nil {
+		t.Fatalf("drive: %v", err)
+		return
+	}
+	var status int
+	p.status.WithLock(func(v *int) { status = *v })
+	if status != http.StatusNoContent {
+		t.Fatalf("in-flight status %d want 204", status)
+		return
+	}
+	var ferr error
+	p.fetchErr.WithLock(func(e *error) { ferr = *e })
+	if ferr != nil {
+		t.Fatalf("in-flight request failed: %v", ferr)
+		return
+	}
+	var serr error
+	p.stopErr.WithLock(func(e *error) { serr = *e })
+	if serr != nil {
+		t.Fatalf("Stop during a live H3 request: %v", serr)
+		return
+	}
+	var dur time.Duration
+	p.stopDur.WithLock(func(d *time.Duration) { dur = *d })
+	if dur < 40*time.Millisecond {
+		t.Fatalf("Stop returned after %v, before the in-flight request ended", dur)
+		return
+	}
+}
