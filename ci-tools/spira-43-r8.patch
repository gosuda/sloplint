-func attemptH3EarlyData(ctx context.Context, addr string, clientTLS *tls.Config, sent chan struct{}) error {
-	target := net.ResolveUDPAddr("udp4", addr)?
-	socket := net.ListenPacket("udp4", "127.0.0.1:0")?
-	defer socket.Close()?
-	observed := &h3EarlyUDP{PacketConn: socket, markSent: stdsync.OnceFunc(func() { close(sent) })}
-	transport := &quic.Transport{Conn: observed}
-	defer transport.Close()?
-	conn := transport.DialEarly(ctx, target, clientTLS, &quic.Config{Versions: []quic.Version{quic.Version1}})?
-	defer conn.CloseWithError(0, "")?
-	if conn.ConnectionState().TLS.HandshakeComplete {
-		return errors.New("QUIC handshake completed before the 0-RTT attempt")
-	}
-	stream := conn.OpenUniStream()?
-	var multiPacketProbe [4096]byte
-	multiPacketProbe[0] = 0x21
-	stream.Write(multiPacketProbe[:])?
-	stream.Close()?
-	select {
-	case <-sent:
-	case <-ctx.Done():
-		return fmt.Errorf("wait for an outgoing QUIC 0-RTT packet: %w", ctx.Err())
-	}
-	select {
-	case <-conn.HandshakeComplete():
-	case <-conn.Context().Done():
-		return context.Cause(conn.Context())
-	case <-ctx.Done():
-		return fmt.Errorf("complete resumed QUIC handshake: %w", ctx.Err())
-	}
-	resumed := conn.NextConnection(ctx)?
-	state := resumed.ConnectionState()
-	if !state.TLS.DidResume {
-		return errors.New("HTTP/3 server did not resume the seeded TLS session")
-	}
-	if state.Used0RTT {
-		return errors.New("HTTP/3 server accepted QUIC 0-RTT data")
-	}
-	return nil
-}
