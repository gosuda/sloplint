-func huffDecode(src []byte) (string, error) {
-	var out []byte
-	var cur uint64
-	var n uint
-	for _, b := range src {
-		cur = cur<<8 | uint64(b)
-		n += 8
-		for {
-			sym, ln, ok := huffLookup(cur, n)
-			if !ok {
-				break
-			}
-			out = append(out, byte(sym))
-			if n == uint(ln) {
-				cur = 0
-			} else {
-				cur &= (uint64(1) << (n - uint(ln))) - 1
-			}
-			n -= uint(ln)
-		}
-	}
-	if n > 7 {
-		return "", errors.New("h2 test client: bad Huffman padding")
-	}
-	if n > 0 && cur != (uint64(1)<<n)-1 {
-		return "", errors.New("h2 test client: bad Huffman padding")
-	}
-	return string(out), nil
-}
-
-func huffLookup(cur uint64, n uint) (int, int, bool) {
-	for sym := 0; sym < 256; sym++ {
-		ln := int(huffLen[sym])
-		if ln == 0 || uint(ln) > n {
-			continue
-		}
-		mask := (uint64(1) << uint(ln)) - 1
-		if cur>>(n-uint(ln))&mask == uint64(huffCode[sym]) {
-			return sym, ln, true
-		}
-	}
-	return 0, 0, false
-}
