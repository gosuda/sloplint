-func (h *h2client) readFrame() (h2frame, error) {
-	var hdr [9]byte
-	if _, err := io.ReadFull(h.reader, hdr[:]); err != nil {
-		return h2frame{}, err
-	}
-	n := int(hdr[0])<<16 | int(hdr[1])<<8 | int(hdr[2])
-	payload := make([]byte, n)
-	if _, err := io.ReadFull(h.reader, payload); err != nil {
-		return h2frame{}, err
-	}
-	id := uint32(hdr[5])<<24 | uint32(hdr[6])<<16 | uint32(hdr[7])<<8 | uint32(hdr[8])
-	id &= 0x7fffffff
-	return h2frame{ftype: hdr[3], flags: hdr[4], id: id, payload: payload}, nil
