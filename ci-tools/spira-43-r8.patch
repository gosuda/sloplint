+func h3CallerServeNoRouter(t *testing.T) {
+	cert, _ := testCert(t)
+	server := &http3.Server{TLS: &tls.Config{Certificates: []tls.Certificate{cert}}, H3: true}
+	listener, packet := bindH3CallerSockets(t)
+	defer closeH3CallerSockets(t, listener, packet)
+	err := server.Serve(context.Background(), listener, packet)
+	if err == nil {
+		t.Fatal("Serve without a router succeeded")
+		return
