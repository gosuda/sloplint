+			t.Fatalf("H3-disabled server bound UDP at %q", addr)
+		}
+		if got := h3AltSvcAtRouter(router); got != "" {
+			t.Fatalf("Alt-Svc with H3 disabled: %q", got)
+		}
+	})
+	t.Run("stopped H3 does not advertise UDP", func(t *testing.T) {
+		router := web.NewRouter()
+		server := &http3.Server{Addr: "127.0.0.1:0", Router: router, ShutdownGrace: 2 * time.Second, TLS: &tls.Config{Certificates: []tls.Certificate{cert}}, H3: true}
+		router.Use(server.AltSvc())
+		router.Handle("GET", "/hello", h3Hello)
+		if err := server.Start(t.Context()); err != nil {
+			t.Fatalf("start: %v", err)
+			return
+		}
+		defer stopH3Server(t, server)
+		want := "h3=\":" + udpPortOf(t, server.BoundUDPAddrForTest()) + "\"; ma=2592000"
+		if got := h3AltSvcAtRouter(router); got != want {
+			t.Fatalf("Alt-Svc before stop = %q, want %q", got, want)
+		}
+		stopH3Server(t, server)
+		if got := h3AltSvcAtRouter(router); got != "" {
+			t.Fatalf("Alt-Svc after stop = %q", got)
+		}
