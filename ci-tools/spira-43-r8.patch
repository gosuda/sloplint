+type h3ReplyCase struct {
+	path        string
+	status      int
+	contentType string
+	bodyPart    string
+}
+
+func checkH3Reply(t *testing.T, client *http.Client, origin string, want h3ReplyCase) {
+	t.Helper()
+	resp, err := client.Get(origin + want.path)
+	if err != nil {
+		t.Fatalf("GET %s: %v", want.path, err)
+		return
+	}
+	defer func() {
+		if err := resp.Body.Close(); err != nil {
+			t.Errorf("close response: %v", err)
+		}
+	}()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatalf("read %s: %v", want.path, err)
+		return
+	}
+	if resp.StatusCode != want.status || resp.Header.Get("Content-Type") != want.contentType {
+		t.Fatalf("%s: status %d, content type %q", want.path, resp.StatusCode, resp.Header.Get("Content-Type"))
+	}
+	if resp.Header.Get("X-Test-Stage") != "ran" || !strings.Contains(string(body), want.bodyPart) {
+		t.Fatalf("%s: stage %q, body %q", want.path, resp.Header.Get("X-Test-Stage"), body)
+	}
+}
+
+func TestH3RunsStagesAndRepliesLikeTCP(t *testing.T) {
+	router := web.NewRouter()
+	router.Use(func(next web.Handler) web.Handler {
+		return func(ctx *web.Context) (web.Reply, error) {
+			ctx.ResponseHeader().Set("X-Test-Stage", "ran")
+			return next(ctx)
+		}
+	})
+	router.Layout = func(_ *web.Context, page web.Page) view.Node {
+		return view.Html(view.Body(page.Body))
+	}
+	router.Handle("GET", "/data", func(_ *web.Context) (web.Reply, error) {
+		return web.Data{Value: "data-payload", Status: http.StatusCreated}, nil
+	})
+	router.Handle("GET", "/page", func(_ *web.Context) (web.Reply, error) {
+		return web.Page{Title: "Page", Body: view.P(view.T("page-payload")), Status: http.StatusAccepted}, nil
+	})
+	router.Handle("GET", "/problem", func(_ *web.Context) (web.Reply, error) {
+		return web.Problem{Title: "missing item", Status: http.StatusNotFound}, nil
+	})
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	server := startH3Server(t, router, cert, 2*time.Second)
+	if server == nil {
+		return
+	}
+	tcpTransport := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: pool}}
+	defer tcpTransport.CloseIdleConnections()
+	udpTransport := http3peer.NewTransport(&tls.Config{RootCAs: pool})
+	defer closeH3Transport(t, udpTransport)
+	tcp := &http.Client{Transport: tcpTransport, Timeout: 5 * time.Second}
+	udp := &http.Client{Transport: udpTransport, Timeout: 5 * time.Second}
+	cases := []h3ReplyCase{
+		{"/data", http.StatusCreated, "application/json", `"data-payload"`},
+		{"/page", http.StatusAccepted, "text/html; charset=utf-8", "page-payload"},
+		{"/problem", http.StatusNotFound, "application/problem+json", "missing item"},
+	}
+	for _, tc := range cases {
+		t.Run(strings.TrimPrefix(tc.path, "/"), func(t *testing.T) {
+			checkH3Reply(t, tcp, "https://"+server.BoundTCPAddrForTest(), tc)
+			checkH3Reply(t, udp, "https://"+server.BoundUDPAddrForTest(), tc)
+		})
+	}
+}
