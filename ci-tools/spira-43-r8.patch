+
+func seedH3EarlySession(ctx context.Context, serverTLS *tls.Config, clientTLS *tls.Config, ready <-chan *tls.ClientSessionState) error {
+	socket := net.ListenPacket("udp4", "127.0.0.1:0")?
+	defer socket.Close()?
+	transport := &quic.Transport{Conn: socket}
+	defer transport.Close()?
+	listener := transport.ListenEarly(serverTLS, &quic.Config{
+		Allow0RTT: true, RequireStreamCreditRelease: true,
+		MaxIncomingStreams: 1, MaxIncomingUniStreams: 1,
+	})?
+	defer listener.Close()?
+	conn := quic.DialAddr(ctx, listener.Addr().String(), clientTLS, &quic.Config{Versions: []quic.Version{quic.Version1}})?
+	defer conn.CloseWithError(0, "")?
+	select {
+	case ticket := <-ready:
+		_, state := ticket.ResumptionState()?
+		if state == nil || !state.EarlyData {
+			return errors.New("seed server did not issue an early-data ticket")
+		}
+		return nil
+	case <-ctx.Done():
+		return fmt.Errorf("wait for TLS session ticket: %w", ctx.Err())
+	}
+}
+
+type h3EarlyUDP struct {
+	net.PacketConn
+	markSent func()
+}
+
+func (c *h3EarlyUDP) WriteTo(data []byte, addr net.Addr) (int, error) {
+	const longHeaderTypeBits = 0b10110000
+	const zeroRTTLongHeader = 0b10010000
+	n, err := c.PacketConn.WriteTo(data, addr)
+	if err == nil && n >= 5 && data[0]&longHeaderTypeBits == zeroRTTLongHeader &&
+		binary.BigEndian.Uint32(data[1:5]) == uint32(quic.Version1) {
+		c.markSent()
+	}
+	return n, err
+}
+
+func attemptH3EarlyData(ctx context.Context, addr string, clientTLS *tls.Config, sent chan struct{}) error {
+	target := net.ResolveUDPAddr("udp4", addr)?
+	socket := net.ListenPacket("udp4", "127.0.0.1:0")?
+	defer socket.Close()?
+	observed := &h3EarlyUDP{PacketConn: socket, markSent: stdsync.OnceFunc(func() { close(sent) })}
+	transport := &quic.Transport{Conn: observed}
+	defer transport.Close()?
+	conn := transport.DialEarly(ctx, target, clientTLS, &quic.Config{Versions: []quic.Version{quic.Version1}})?
+	defer conn.CloseWithError(0, "")?
+	if conn.ConnectionState().TLS.HandshakeComplete {
+		return errors.New("QUIC handshake completed before the 0-RTT attempt")
+	}
+	stream := conn.OpenUniStream()?
+	deadline, ok := ctx.Deadline()
+	if !ok {
+		return errors.New("early-data probe requires a deadline")
+	}
+	stream.SetWriteDeadline(deadline)?
+	var multiPacketProbe [4096]byte
+	multiPacketProbe[0] = 0x21
+	if _, err := stream.Write(multiPacketProbe[:]); err != nil && !errors.Is(err, quic.Err0RTTRejected) {
+		return fmt.Errorf("write early data: %w", err)
+	}
+	if err := stream.Close(); err != nil && !errors.Is(err, quic.Err0RTTRejected) {
+		return fmt.Errorf("close early-data stream: %w", err)
+	}
+	select {
+	case <-sent:
+	case <-ctx.Done():
+		return fmt.Errorf("wait for an outgoing QUIC 0-RTT packet: %w", ctx.Err())
+	}
+	select {
+	case <-conn.HandshakeComplete():
+	case <-conn.Context().Done():
+		return context.Cause(conn.Context())
+	case <-ctx.Done():
+		return fmt.Errorf("complete resumed QUIC handshake: %w", ctx.Err())
+	}
+	resumed := conn.NextConnection(ctx)?
+	state := resumed.ConnectionState()
+	if !state.TLS.DidResume {
+		return errors.New("HTTP/3 server did not resume the seeded TLS session")
+	}
+	if state.Used0RTT {
+		return errors.New("HTTP/3 server accepted QUIC 0-RTT data")
+	}
+	return nil
+}
