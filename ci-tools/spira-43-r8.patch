+			return
+		}
+		defer func() {
+			if err := packet.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
+				t.Errorf("close UDP port: %v", err)
+			}
+		}()
+		addr := packet.LocalAddr().String()
+		cert, _ := testCert(t)
+		server := &http3.Server{Addr: addr, Router: web.NewRouter(), TLS: &tls.Config{Certificates: []tls.Certificate{cert}}, H3: true}
+		defer stopH3Server(t, server)
+		ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
+		defer cancel()
+		probe := &h3ConflictProbe{server: server, packet: packet, result: make(chan error, 1)}
+		if err := driveTransientH3Start(ctx, probe); err != nil {
+			t.Fatalf("transient UDP conflict: %v", err)
+			return
+		}
+		if got := server.BoundUDPAddrForTest(); got != addr {
+			t.Fatalf("bound UDP address %q, want %q", got, addr)
