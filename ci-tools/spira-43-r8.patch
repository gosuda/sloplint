-func hpackIndexed(idx uint64, dyn []h2entry) (string, string, error) {
-	if idx >= 1 && idx <= 61 {
-		return hpackStaticName[idx-1], hpackStaticValue[idx-1], nil
-	}
-	if idx >= 62 && idx-62 < uint64(len(dyn)) {
-		e := dyn[len(dyn)-1-int(idx-62)]
-		return e.name, e.value, nil
-	}
-	return "", "", fmt.Errorf("h2 test client: bad HPACK index %d", idx)
-}
