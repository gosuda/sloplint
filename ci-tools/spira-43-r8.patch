+type h3EarlySessionCache struct {
+	tls.ClientSessionCache
+	ready chan *tls.ClientSessionState
+}
+
+func (c *h3EarlySessionCache) Put(key string, session *tls.ClientSessionState?) {
+	c.ClientSessionCache.Put(key, session)
+	if session == nil {
+		return
+	}
