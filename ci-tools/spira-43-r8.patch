+
+func TestStreamCancelUnblocksPendingNext(t *testing.T) {
+	pending := make(chan context.CancelFunc, 1)
+	reading := make(chan struct{}, 1)
+	done := make(chan error, 1)
+	srv := serveStreamTLS(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		r.Body = &readEntryBody{ReadCloser: r.Body, entered: reading}
+		c, err := websocket.ServeStream(w, r, websocket.Config{})
+		if err != nil {
+			reportStream(r, done, err)
+			return
+		}
+		if c == nil {
+			reportStream(r, done, errors.New("serve stream gave no connection"))
+			return
+		}
+		defer func() {
+			if cerr := c.Close(); cerr != nil && !errors.Is(cerr, websocket.ErrClosed) {
+				t.Errorf("stream close: %v", cerr)
+			}
+		}()
+		ctx, cancel := context.WithCancel(r.Context())
+		defer cancel()
+		select {
+		case pending <- cancel:
+		case <-r.Context().Done():
+			reportStream(r, done, r.Context().Err())
+			return
+		}
+		_, _, err = c.Next(ctx)
+		probeCtx, probeCancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer probeCancel()
+		_, _, perr := c.Next(probeCtx)
+		reportStream(r, done, errors.Join(err, perr))
+	}))
+	h := openH2TLS(t, srv)
+	if !h.advertised {
+		t.Fatal("cancellation probe requires SETTINGS_ENABLE_CONNECT_PROTOCOL")
+		return
+	}
+	addr := srv.Listener.Addr().String()
+	id := h.nextID
+	h.sendHeaders(t, id, streamConnectFields(addr, ""), false)
+	if status, _ := h.readResponseHeaders(t, id); status != http.StatusOK {
+		t.Fatalf("extended CONNECT status = %d, want 200", status)
+		return
+	}
+	cancelAfterStreamRead(t, pending, reading)
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("Next after cancel returned no error")
+			return
+		}
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("Next after cancel = %v, want context canceled", err)
+		}
+		if !errors.Is(err, websocket.ErrClosed) {
+			t.Fatalf("Next after cancel = %v, want a closed connection after canceling the pending read", err)
+		}
+	case <-time.After(15 * time.Second):
+		t.Fatal("Next did not return after cancel")
+	}
+}
+
+func cancelAfterStreamRead(t *testing.T, pending <-chan context.CancelFunc, reading <-chan struct{}) {
+	t.Helper()
+	var cancel context.CancelFunc
+	select {
+	case cancel = <-pending:
+	case <-time.After(10 * time.Second):
+		t.Fatal("session did not provide its cancel function")
+		return
+	}
+	select {
+	case <-reading:
+	case <-time.After(10 * time.Second):
+		t.Fatal("Next did not enter the request body read")
+		return
+	}
+	cancel()
+}
