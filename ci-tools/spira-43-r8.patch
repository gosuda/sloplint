+func TestStreamRefusesHTTP1Connect(t *testing.T) {
+	srv := httptest.NewServer(streamEchoHandler(t, websocket.Config{}))
+	defer srv.Close()
+	addr := strings.TrimPrefix(srv.URL, "http://")
+	conn, r := dialRaw(t, addr)
+	if _, err := conn.Write([]byte("CONNECT /chat HTTP/1.1\r\nHost: " + addr + "\r\n\r\n")); err != nil {
+		t.Fatalf("write CONNECT: %v", err)
+		return
+	}
+	code, _ := readResponse(t, r)
+	if code != http.StatusBadRequest {
+		t.Fatalf("status = %d, want 400", code)
+		return
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatalf("peer close: %v", err)
+		return
+	}
+}
