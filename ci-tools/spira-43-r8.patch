+func h3CallerServeBusy(t *testing.T) {
+	cert, _ := testCert(t)
+	router := web.NewRouter()
+	router.Handle("GET", "/hello", h3Hello)
+	first := &http3.Server{Router: router, TLS: &tls.Config{Certificates: []tls.Certificate{cert}}, H3: true, ShutdownGrace: 5 * time.Second}
+	ownerListener, ownerPacket := bindH3CallerSockets(t)
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	if err := first.Serve(ctx, ownerListener, ownerPacket); err != nil {
+		cerr := errors.Join(ownerListener.Close(), ownerPacket.Close())
+		t.Fatalf("serve the first pair: %v; close caller sockets: %v", err, cerr)
+		return
+	}
+	t.Cleanup(func() { stopH3Server(t, first) })
+	listener, packet := bindH3CallerSockets(t)
+	defer closeH3CallerSockets(t, listener, packet)
+	err := first.Serve(context.Background(), listener, packet)
+	if err == nil {
+		t.Fatal("second Serve on a busy server succeeded")
+		return
+	}
+	if !strings.Contains(err.Error(), "already started") {
+		t.Fatalf("second Serve error = %v, want an already-started refusal", err)
+		return
+	}
+	assertH3CallerSocketsUsable(t, listener, packet)
+}
+
+func assertH3CallerSocketsUsable(t *testing.T, listener net.Listener, packet net.PacketConn) {
+	t.Helper()
+	assertH3CallerListenerAccepts(t, listener)
+	assertH3CallerPacketRoundTrips(t, packet)
+}
+
+func assertH3CallerListenerAccepts(t *testing.T, listener net.Listener) {
+	t.Helper()
+	tcp, ok := listener.(*net.TCPListener)
+	if !ok {
+		t.Fatalf("caller listener type %T, want *net.TCPListener", listener)
+		return
+	}
+	if serr := tcp.SetDeadline(time.Now().Add(2 * time.Second)); serr != nil {
+		t.Fatalf("set caller TCP accept deadline: %v", serr)
+		return
+	}
+	probe, derr := net.DialTimeout("tcp", listener.Addr().String(), 2*time.Second)
+	if derr != nil {
+		t.Fatalf("caller TCP listener refuses connections: %v", derr)
+		return
+	}
+	accepted, aerr := tcp.Accept()
+	if aerr != nil {
+		cerr := probe.Close()
+		t.Fatalf("caller TCP listener did not accept the probe: %v; close probe: %v", aerr, cerr)
+		return
+	}
+	if cerr := accepted.Close(); cerr != nil {
+		t.Errorf("close accepted caller probe: %v", cerr)
+	}
+	if cerr := probe.Close(); cerr != nil {
+		t.Errorf("close caller TCP probe: %v", cerr)
+	}
+	if serr := tcp.SetDeadline(time.Time{}); serr != nil && !errors.Is(serr, net.ErrClosed) {
+		t.Errorf("clear caller TCP accept deadline: %v", serr)
+	}
+}
+
+func assertH3CallerPacketRoundTrips(t *testing.T, packet net.PacketConn) {
+	t.Helper()
+	if serr := packet.SetDeadline(time.Now().Add(2 * time.Second)); serr != nil {
+		t.Fatalf("set caller UDP deadline: %v", serr)
+		return
+	}
+	defer func() {
+		if serr := packet.SetDeadline(time.Time{}); serr != nil && !errors.Is(serr, net.ErrClosed) {
+			t.Errorf("clear caller UDP deadline: %v", serr)
+		}
+	}()
+	probe := []byte("caller-probe")
+	if _, werr := packet.WriteTo(probe, packet.LocalAddr()); werr != nil {
+		t.Fatalf("caller UDP connection refused the write: %v", werr)
+		return
+	}
+	buf := make([]byte, len(probe))
+	n, _, rerr := packet.ReadFrom(buf)
+	if rerr != nil {
+		t.Fatalf("caller UDP connection did not receive its own datagram: %v", rerr)
+		return
+	}
+	if string(buf[:n]) != string(probe) {
+		t.Fatalf("caller UDP datagram = %q, want %q", buf[:n], probe)
+		return
+	}
+}
+
+func TestH3RejectsNonH3ALPNOnUDP(t *testing.T) {
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	base := &tls.Config{Certificates: []tls.Certificate{cert}, NextProtos: []string{"not-h3"}}
+	selected := &tls.Config{Certificates: []tls.Certificate{cert}, NextProtos: []string{"not-h3"}}
+	callback := &tls.Config{
+		NextProtos: []string{"not-h3"},
+		GetConfigForClient: func(_ *tls.ClientHelloInfo) (*tls.Config, error) {
+			return selected, nil
+		},
+	}
+	cases := []struct {
+		name   string
+		config *tls.Config
+	}{{"base", base}, {"callback", callback}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			server := &http3.Server{Addr: "127.0.0.1:0", Router: web.NewRouter(), TLS: tc.config, H3: true}
+			if err := server.Start(t.Context()); err != nil {
+				t.Fatalf("start: %v", err)
+				return
+			}
+			defer stopH3Server(t, server)
+			addr := server.BoundUDPAddrForTest()
+			if addr == "" {
+				t.Fatal("no UDP bound address")
+				return
+			}
+			assertH3ALPN(t, addr, pool)
+			ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+			defer cancel()
+			clientTLS := &tls.Config{RootCAs: pool, ServerName: "example.com", NextProtos: []string{"not-h3"}}
+			conn, err := quic.DialAddr(ctx, addr, clientTLS, &quic.Config{})
+			if err == nil {
+				if cerr := conn.CloseWithError(0, ""); cerr != nil {
+					t.Errorf("close connection: %v", cerr)
