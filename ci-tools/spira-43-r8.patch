-	var hdr [9]byte
-	n := len(f.payload)
-	hdr[0] = byte(n >> 16)
-	hdr[1] = byte(n >> 8)
-	hdr[2] = byte(n)
-	hdr[3] = f.ftype
-	hdr[4] = f.flags
-	hdr[5] = byte(f.id >> 24)
-	hdr[6] = byte(f.id >> 16)
-	hdr[7] = byte(f.id >> 8)
-	hdr[8] = byte(f.id)
-	if _, err := h.conn.Write(hdr[:]); err != nil {
-		t.Fatalf("h2 write header: %v", err)
-		panic("h2 write header failed")
-	}
-	if len(f.payload) == 0 {
-		return
-	}
