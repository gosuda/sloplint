+
+type streamCancelResult struct {
+	read     error
+	followup error
+}
+
+func reportStreamCancellation(t *testing.T, done chan<- streamCancelResult, result streamCancelResult) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
+	defer cancel()
+	select {
+	case done <- result:
+	case <-ctx.Done():
+		t.Errorf("stream result was not received: %v", ctx.Err())
+	}
+}
+
+func TestStreamCancelUnblocksPendingNext(t *testing.T) {
+	pending := make(chan context.CancelFunc, 1)
+	reading := make(chan struct{}, 1)
+	done := make(chan streamCancelResult, 1)
+	srv := serveStreamTLS(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		r.Body = &readEntryBody{ReadCloser: r.Body, entered: reading}
+		c, err := websocket.ServeStream(w, r, websocket.Config{})
+		if err != nil {
+			reportStreamCancellation(t, done, streamCancelResult{read: err})
+			return
+		}
+		if c == nil {
+			reportStreamCancellation(t, done, streamCancelResult{read: errors.New("serve stream gave no connection")})
+			return
+		}
+		defer func() {
+			if cerr := c.Close(); cerr != nil && !errors.Is(cerr, websocket.ErrClosed) {
+				t.Errorf("stream close: %v", cerr)
+			}
+		}()
+		ctx, cancel := context.WithCancel(r.Context())
+		defer cancel()
+		select {
+		case pending <- cancel:
+		case <-r.Context().Done():
+			reportStreamCancellation(t, done, streamCancelResult{read: r.Context().Err()})
+			return
+		}
+		_, _, err = c.Next(ctx)
+		probeCtx, probeCancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer probeCancel()
+		_, _, perr := c.Next(probeCtx)
+		reportStreamCancellation(t, done, streamCancelResult{read: err, followup: perr})
+	}))
+	h := openH2TLS(t, srv)
+	if !h.advertised {
+		t.Fatal("cancellation probe requires SETTINGS_ENABLE_CONNECT_PROTOCOL")
+		return
+	}
+	addr := srv.Listener.Addr().String()
+	id := h.nextID
+	h.sendHeaders(t, id, streamConnectFields(addr, ""), false)
+	if status, _ := h.readResponseHeaders(t, id); status != http.StatusOK {
+		t.Fatalf("extended CONNECT status = %d, want 200", status)
+		return
+	}
+	cancelAfterStreamRead(t, pending, reading)
+	select {
+	case result := <-done:
+		if !errors.Is(result.read, context.Canceled) {
+			t.Fatalf("pending Next after cancel = %v, want context canceled", result.read)
+		}
+		if !errors.Is(result.followup, websocket.ErrClosed) {
+			t.Fatalf("follow-up Next = %v, want ErrClosed", result.followup)
+		}
+	case <-time.After(15 * time.Second):
+		t.Fatal("Next did not return after cancel")
+	}
+}
