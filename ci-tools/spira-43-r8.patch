+	if len(base.NextProtos) != 1 || base.NextProtos[0] != "not-h3" {
+		t.Errorf("base TLS ALPN changed: %v", base.NextProtos)
+	}
+	if len(selected.NextProtos) != 1 || selected.NextProtos[0] != "not-h3" {
+		t.Errorf("callback TLS ALPN changed: %v", selected.NextProtos)
