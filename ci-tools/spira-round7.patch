diff --git a/db/pool_expiry_test.lgo b/db/pool_expiry_test.lgo
new file mode 100644
index 0000000..362b5e1
--- /dev/null
+++ b/db/pool_expiry_test.lgo
@@ -0,0 +1,199 @@
+package db_test
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/gosuda/spira/db"
+)
+
+func openExpiryPool(t *testing.T, dsn string, opts ...db.PoolOptions) *db.Pool {
+	t.Helper()
+	pool, err := db.Open("sqlite", dsn, opts...)
+	if err != nil {
+		t.Fatalf("Open: %v", err)
+	}
+	if pool == nil {
+		panic("Open returned no pool")
+	}
+	t.Cleanup(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		if err := pool.Stop(ctx); err != nil {
+			t.Errorf("Stop: %v", err)
+		}
+	})
+	return pool
+}
+
+func waitPoolDuration(t *testing.T, duration time.Duration) {
+	t.Helper()
+	timer := time.NewTimer(duration)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+	case <-t.Context().Done():
+		t.Fatal(t.Context().Err())
+	}
+}
+
+func TestMemoryPoolsKeepRowsAcrossDefaultExpiry(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		dsn  string
+		open int
+	}{
+		{"plain", ":memory:", 1},
+		{"plain_query", ":memory:?_pragma=foreign_keys(1)", 1},
+		{"uri_private", "file::memory:", 1},
+		{"uri_encoded", "file:%3Amemory%3A", 1},
+		{"uri_shared", "file::memory:?cache=shared", 4},
+		{"named_private", "file:" + txPoolKey(t) + "_private?mode=memory", 1},
+		{"named_shared", "file:" + txPoolKey(t) + "_shared?mode=memory&cache=shared", 4},
+		{"encoded_mode", "file:" + txPoolKey(t) + "_encoded?mode=%6demory&cache=shared", 4},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pool := openExpiryPool(t, tc.dsn)
+			pool.AccelerateExpiryForTest(tc.dsn, 10*time.Millisecond)
+			createThings(t, pool)
+			insertThingRow(t, pool)
+			waitPoolDuration(t, 30*time.Millisecond)
+			ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+			defer cancel()
+			rows, err := pool.QueryContext(ctx, "SELECT n FROM things")
+			if err != nil {
+				t.Fatalf("query after default expiry: %v", err)
+			}
+			if rows == nil {
+				t.Fatal("query returned no rows")
+				return
+			}
+			defer closeRows(t, rows)
+			var n int
+			if !rows.Next() {
+				t.Fatalf("row disappeared: %v", rows.Err())
+			}
+			if err := rows.Scan(&n); err != nil || n != 7 {
+				t.Fatalf("row = %d, error = %v, want 7", n, err)
+			}
+			if got := pool.Stats().MaxOpenConnections; got != tc.open {
+				t.Fatalf("open limit = %d, want %d", got, tc.open)
+			}
+		})
+	}
+}
+
+func TestPersistentPoolsKeepTimedEviction(t *testing.T) {
+	for _, d := range []db.Dialect{db.SQLite{}, db.Postgres{}, db.MySQL{}, db.MSSQL{}} {
+		opts := db.PoolOptionsForTest(d, filepath.Join(t.TempDir(), "data.db"))
+		if opts.ConnMaxLifetime != 30*time.Minute || opts.ConnMaxIdleTime != 5*time.Minute {
+			t.Fatalf("persistent defaults = %+v", opts)
+		}
+	}
+	dsn := filepath.Join(t.TempDir(), "data.db")
+	pool := openExpiryPool(t, dsn)
+	pool.AccelerateExpiryForTest(dsn, 10*time.Millisecond)
+	createThings(t, pool)
+	insertThingRow(t, pool)
+	waitPoolDuration(t, 30*time.Millisecond)
+	if got := countThings(t, pool); got != 1 {
+		t.Fatalf("persistent rows = %d, want 1", got)
+	}
+	if pool.Stats().MaxLifetimeClosed == 0 {
+		t.Fatal("persistent pool did not retire the expired connection")
+	}
+}
+
+func TestPoolOptionsFoldInOrder(t *testing.T) {
+	opts := []db.PoolOptions{
+		{MaxOpenConns: 2, MaxIdleConns: 1},
+		{MaxOpenConns: 3, ConnMaxLifetime: time.Minute},
+		{ConnMaxIdleTime: 30 * time.Second},
+		{},
+	}
+	dsn := filepath.Join(t.TempDir(), "options.db")
+	pool := openExpiryPool(t, dsn, opts...)
+	if pool.Stats().MaxOpenConnections != 3 {
+		t.Fatalf("later open limit ignored: %+v", pool.Stats())
+	}
+	want := db.PoolOptions{MaxOpenConns: 3, MaxIdleConns: 1, ConnMaxLifetime: time.Minute, ConnMaxIdleTime: 30 * time.Second}
+	if got := db.PoolOptionsForTest(db.SQLite{}, dsn, opts...); got != want {
+		t.Fatalf("resolved options = %+v, want %+v", got, want)
+	}
+	disabled := db.PoolOptions{MaxOpenConns: -1, MaxIdleConns: -1, ConnMaxLifetime: -1, ConnMaxIdleTime: -1}
+	if got := db.PoolOptionsForTest(db.SQLite{}, dsn, disabled); got != disabled {
+		t.Fatalf("negative overrides = %+v, want %+v", got, disabled)
+	}
+}
+
+func holdPoolConnection(t *testing.T, ctx context.Context, pool *db.Pool) *sql.Conn {
+	t.Helper()
+	conn, err := pool.HoldConnectionForTest(ctx)
+	if err != nil {
+		t.Fatalf("hold connection: %v", err)
+	}
+	if conn == nil {
+		panic("pool returned no connection")
+	}
+	t.Cleanup(func() {
+		if err := conn.Close(); err != nil && !errors.Is(err, sql.ErrConnDone) {
+			t.Errorf("close connection: %v", err)
+		}
+	})
+	return conn
+}
+
+func TestPoolIdleLimitClosesExtraConnection(t *testing.T) {
+	pool := openExpiryPool(t, filepath.Join(t.TempDir(), "idle.db"), db.PoolOptions{MaxOpenConns: 2, MaxIdleConns: 1})
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	first := holdPoolConnection(t, ctx, pool)
+	second := holdPoolConnection(t, ctx, pool)
+	if err := first.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := second.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if stats := pool.Stats(); stats.Idle != 1 || stats.MaxIdleClosed != 1 {
+		t.Fatalf("idle limit was not applied: %+v", stats)
+	}
+}
+
+func TestPoolLifetimeClosesExpiredConnection(t *testing.T) {
+	pool := openExpiryPool(t, filepath.Join(t.TempDir(), "age.db"), db.PoolOptions{ConnMaxLifetime: 10 * time.Millisecond})
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	if err := pool.Start(ctx); err != nil {
+		t.Fatal(err)
+	}
+	waitPoolDuration(t, 30*time.Millisecond)
+	if err := pool.Start(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if stats := pool.Stats(); stats.MaxLifetimeClosed == 0 {
+		t.Fatalf("lifetime was not applied: %+v", stats)
+	}
+}
+
+func TestPoolIdleTimeClosesExpiredConnection(t *testing.T) {
+	pool := openExpiryPool(t, filepath.Join(t.TempDir(), "idle-time.db"), db.PoolOptions{ConnMaxIdleTime: 10 * time.Millisecond})
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	if err := pool.Start(ctx); err != nil {
+		t.Fatal(err)
