@@ -0,0 +1,57 @@
+package main_test
+
+import (
+	"encoding/json/v2"
+	"os"
+	"strings"
+	"testing"
+
+	sqlcgen "github.com/gosuda/spira/cmd/sqlc-gen-spira"
+)
+
+func TestPackageNameAcceptsUnicode(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		pkg  string
+		out  string
+	}{
+		{name: "explicit package", pkg: "données", out: "gen"},
+		{name: "output directory", out: "db/données"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			data, err := os.ReadFile("testdata/sqlite/request.json")
+			if err != nil {
+				t.Fatal(err)
+				return
+			}
+			var req sqlcgen.Request
+			if err := json.Unmarshal(data, &req); err != nil {
+				t.Fatal(err)
+				return
+			}
+			req.Settings.Codegen.Out = tc.out
+			if tc.pkg != "" {
+				options, err := json.Marshal(sqlcgen.PluginOptions{Package: tc.pkg})
+				if err != nil {
+					t.Fatal(err)
+					return
+				}
+				req.PluginOptions = options
+			}
+			_, files, err := sqlcgen.Generate(&req)
+			if err != nil {
+				t.Fatalf("Generate: %v", err)
+				return
+			}
+			for _, file := range files {
+				if file.Name == "models.sql.lgo" {
+					if !strings.Contains(string(file.Contents), "package données\n") {
+						t.Fatalf("generated models omit the Unicode package: %s", file.Contents)
+					}
+					return
+				}
+			}
+			t.Fatal("Generate returned no models.sql.lgo")
+		})
+	}
+}
