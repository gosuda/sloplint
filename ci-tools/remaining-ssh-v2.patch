-func (c *Client) inputLoop(reader *bufio.Reader) {
-	for {
-		r, _, err := reader.ReadRune()
-		if err != nil {
-			c.Close()
-			return
-		}
-
-		switch r {
-		case '\r':
-			c.handleEnter()
-		case '\n':
-			// ignore bare line feeds; carriage return already handled
-		case 127, '\b':
-			c.handleBackspace()
-		case 3: // Ctrl+C
-			c.Close()
-			return
-		case 4: // Ctrl+D
-			c.Close()
-			return
-		case '\x1b':
-			c.handleEscape(reader)
-		default:
-			if !isControlRune(r) {
-				c.handleRune(r)
-			}
-		}
-	}
-}
