+	"github.com/gosuda/spira/db"
+
+	"modernc.org/sqlite"
+)
+
+const insertThing = "INSERT INTO things (n) VALUES (?)"
+
+const cacheLimit = 256
+
+func openPool(t *testing.T) *db.Pool {
+	t.Helper()
+	key := strings.NewReplacer("/", "_", "(", "_", ")", "_").Replace(t.Name())
+	pool, err := db.Open("sqlite", fmt.Sprintf("file:spira_%s?mode=memory&cache=shared", key))
+	if err != nil {
+		panic(fmt.Sprintf("db_test: open %s: %v", key, err))
+	}
+	if pool == nil {
+		panic("db_test: Open returned no pool")
+	}
+	t.Cleanup(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		if err := pool.Stop(ctx); err != nil {
+			t.Errorf("Stop: %v", err)
+		}
+	})
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	if serr := pool.Start(ctx); serr != nil {
+		panic(fmt.Sprintf("db_test: start %s: %v", key, serr))
+	}
+	return pool
+}
+
+func createThings(t *testing.T, pool *db.Pool) {
+	t.Helper()
+	if _, err := db.Exec(t.Context(), pool, "CREATE TABLE things (n integer not null)"); err != nil {
+		panic(fmt.Sprintf("db_test: create: %v", err))
+	}
+}
+
+func insertThingRow(t *testing.T, q db.Querier) {
+	t.Helper()
+	if _, err := db.Exec(t.Context(), q, insertThing, 7); err != nil {
+		panic(fmt.Sprintf("db_test: insert: %v", err))
+	}
+}
+
+func countThings(t *testing.T, pool *db.Pool) int {
+	t.Helper()
+	rows, err := pool.QueryContext(t.Context(), "SELECT COUNT(*) FROM things")
+	if err != nil {
+		panic(fmt.Sprintf("db_test: count: %v", err))
+	}
+	if rows == nil {
+		panic("db_test: count returned no rows handle")
+	}
+	defer closeRows(t, rows)
+	if !rows.Next() {
+		t.Fatal("count: query returned no row")
+	}
+	var n int
+	if serr := rows.Scan(&n); serr != nil {
+		t.Fatalf("scan: %v", serr)
+	}
+	return n
+}
+
+func closeRows(t *testing.T, rows *sql.Rows?) {
+	if rows == nil {
+		return
+	}
+	if err := rows.Close(); err != nil {
+		t.Errorf("close: %v", err)
+	}
+}
