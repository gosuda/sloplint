-func dialectName(d db.Dialect) string {
-	switch d.(type) {
-	case db.SQLite:
-		return "sqlite"
-	case db.Postgres:
-		return "postgres"
-	case db.MySQL:
-		return "mysql"
-	case db.MSSQL:
-		return "mssql"
-	case nil:
-		return "nil"
-	}
-	return "unknown"
-}
