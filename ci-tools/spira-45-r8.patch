 	}
 	p.check(dupErr)
 }
+
+func TestConstraintProbeDropsAfterContextCancellation(t *testing.T) {
+	pool := openPool(t)
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	withConstraintProbe(t, ctx, pool, constraintProbe{
+		table: "fault_uniq_cancel",
+		mark:  "?",
+		check: func(err error) {
+			if !errors.Is(err, db.ErrConstraintViolation) {
+				t.Fatalf("duplicate insert = %v, want constraint violation", err)
+				return
+			}
+			cancel()
+		},
+	})
+	faultExec(t, pool, "CREATE TABLE fault_uniq_cancel (n INTEGER NOT NULL UNIQUE)")
+	faultExec(t, pool, "DROP TABLE fault_uniq_cancel")
+}
