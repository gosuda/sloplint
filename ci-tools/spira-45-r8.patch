+		panic("db_test: raw query returned no rows handle")
+	}
+	defer closeRows(t, rows)
+	if !rows.Next() {
+		t.Fatal("raw query returned no row")
+	}
+	var raw plainRow
+	if serr := rows.Scan(&raw.ID, &raw.N, &raw.I8, &raw.I16, &raw.I32, &raw.F32, &raw.F64, &raw.S, &raw.Code, &raw.B, &raw.Yes); serr != nil {
+		t.Fatalf("raw scan: %v", serr)
+	}
