-	if got.F32 != want.F32 || got.F64 != want.F64 || got.S != want.S || string(got.Code) != string(want.Code) || got.Yes != want.Yes {
-		return fmt.Errorf("value columns = %+v, want %+v", got, want)
-	}
-	if string(got.B) != string(want.B) {
-		return fmt.Errorf("blob = %q, want %q", got.B, want.B)
-	}
-	return nil
