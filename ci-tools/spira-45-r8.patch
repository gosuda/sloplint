+type stopOutcome struct {
+	err  sync.Locked[error]
+	done chan struct{}
+}
+
+func detached(work func()) {
+	ctx, cancel := context.WithCancel(context.Background())
+	context.AfterFunc(ctx, work)
+	cancel()
+}
+
+func registerBlockingFunction(ctx context.Context, started chan struct{}, release chan struct{}) string {
+	block := func(_ *sqlite.FunctionContext, _ []driver.Value) (driver.Value, error) {
+		select {
+		case started <- struct{}{}:
+		case <-ctx.Done():
+		}
+		select {
+		case <-release:
+		case <-ctx.Done():
+		}
+		return int64(1), nil
+	}
+	name := fmt.Sprintf("spira_block_stop_%d", time.Now().UnixNano())
+	if err := sqlite.RegisterScalarFunction(name, 0, block); err != nil {
+		panic(fmt.Sprintf("db_test: register function: %v", err))
+	}
+	return name
+}
+
+func checkStopShutdown(t *testing.T, ctx context.Context, pool *db.Pool, stop *stopOutcome) {
+	t.Helper()
+	var serr error
+	stop.err.WithLock(func(e *error) { serr = *e })
+	if !errors.Is(serr, context.DeadlineExceeded) || !strings.Contains(serr.Error(), "db: stop:") {
+		t.Fatalf("Stop error = %v, want db: stop: context deadline exceeded", serr)
+	}
+	closed := false
+	for !closed && ctx.Err() == nil {
+		_, qerr := pool.ExecContext(ctx, "/*db:nocache*/SELECT 1")
+		closed = qerr != nil && strings.Contains(qerr.Error(), "database is closed")
+		if !closed {
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+	if !closed {
+		t.Fatal("the pool stayed open after the timed-out Stop and the end of the statement")
+	}
+	if got := pool.Prepared(); got != 0 {
+		t.Fatalf("cache holds %d statements after Stop, want 0", got)
+	}
+}
+
+func TestStopReturnsByItsDeadlineWhileAStatementRuns(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	defer cancel()
+	started := make(chan struct{}, 1)
+	release := make(chan struct{})
+	blocker := registerBlockingFunction(ctx, started, release)
+	pool := openPool(t)
+	statement := &stopOutcome{done: make(chan struct{})}
+	detached(func() {
+		_, qerr := pool.ExecContext(ctx, "SELECT "+blocker+"()")
+		statement.err.WithLock(func(e *error) { *e = qerr })
+		close(statement.done)
+	})
+	select {
+	case <-started:
+	case <-ctx.Done():
+		t.Fatal("the blocking statement did not start")
+	}
+	stopCtx, stopCancel := context.WithTimeout(ctx, 50*time.Millisecond)
+	defer stopCancel()
+	stop := &stopOutcome{done: make(chan struct{})}
+	detached(func() {
+		serr := pool.Stop(stopCtx)
+		stop.err.WithLock(func(e *error) { *e = serr })
+		close(stop.done)
+	})
+	returnedInTime := true
+	select {
+	case <-stop.done:
+	case <-time.After(2 * time.Second):
+		returnedInTime = false
+	}
+	close(release)
+	select {
+	case <-statement.done:
+	case <-ctx.Done():
+		t.Fatal("the blocking statement did not finish after its release")
+	}
+	if !returnedInTime {
+		t.Fatal("Stop did not return by its 50ms deadline while a cached statement ran")
+	}
+	checkStopShutdown(t, ctx, pool, stop)
+	}
+
+func TestDialectOfMatchesEachDriverName(t *testing.T) {
+	cases := []struct {
+		driver string
+		dsn    string
+		want   string
+	}{
+		{"sqlite", "file:x?mode=memory", "sqlite"},
+		{"pgx", "postgres://localhost/db", "postgres"},
+		{"postgres", "postgres://localhost/db", "postgres"},
+		{"mysql", "user@/db?parseTime=true", "mysql"},
+		{"sqlserver", "sqlserver://localhost?database=db", "mssql"},
+	}
+	for _, c := range cases {
+		d, err := db.DialectOf(c.driver, c.dsn)
+		if err != nil {
+			panic(fmt.Sprintf("db_test: DialectOf(%s): %v", c.driver, err))
+		}
+		if got := dialectName(d); got != c.want {
+			t.Fatalf("DialectOf(%s) = %s, want %s", c.driver, got, c.want)
+		}
+	}
+	if _, err := db.DialectOf("mysql", "user@/db"); err == nil || !errors.Is(err, db.ErrMissingParseTime) {
+		t.Fatalf("DialectOf(mysql, missing parseTime) error = %v", err)
+	}
+	if _, err := db.DialectOf("oracle", "x"); err == nil || !errors.Is(err, db.ErrUnknownDriver) {
+		t.Fatalf("DialectOf(oracle) error = %v", err)
+	}
+}
+
+func dialectName(d db.Dialect) string {
+	switch d.(type) {
+	case db.SQLite:
+		return "sqlite"
+	case db.Postgres:
+		return "postgres"
+	case db.MySQL:
+		return "mysql"
+	case db.MSSQL:
+		return "mssql"
+	case nil:
+		return "nil"
+	}
+	return "unknown"
+}
