+func TestInTxCommitsOnSuccess(t *testing.T) {
+	pool := openPool(t)
+	createThings(t, pool)
+	saved, err := db.InTx[int](t.Context(), pool, func(tx *db.Tx) (int, error) {
+		insertThingRow(t, tx)
+		return 7, nil
+	})
+	if err != nil {
+		panic(fmt.Sprintf("db_test: InTx: %v", err))
