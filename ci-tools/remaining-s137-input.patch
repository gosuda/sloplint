-    verbatim_here_string_characters: ($) =>
-      token(
-        seq(
-          /@\'\s*\r?\n/,
-          repeat(choice(/[^\r\n]/, /(\r?\n)+[^\'\r\n]/, /\r?\n\'[^@]/)),
