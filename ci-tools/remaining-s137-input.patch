-            token(seq(/[eE]/, optional(choice('+', '-')), /[0-9]+/)),
-            optional(/[kmgtpKMGTP][bB]/),
-          ),
-        ),
-      ),
-
-    // String literal
-    string_literal: ($) =>
-      choice(
-        $.expandable_string_literal,
-        $.verbatim_string_characters,
-        $.expandable_here_string_literal,
-        $.verbatim_here_string_characters,
-      ),
-
-    _expandable_string_part: ($) =>
-      choice(
