--- a/vendor/tree-sitter-powershell/grammar.js
+++ b/vendor/tree-sitter-powershell/grammar.js
@@ -1,1590 +1,1590 @@
-const PREC = {
-  KEYWORD: 1,
-  UNARY: 2,
-  CAST: 3,
-  ELEMENT_ACCESS: 4,
-  EMPTY: 5,
-  PARAM: 6,
-};
-
-// sloplint: a command-line word may hold quoted segments that contain spaces,
-// pipes or parentheses: -x="a b", --format='%H||%P'. The segments are matched as
-// a unit inside the word token. A double-quoted segment holds no nested quote,
-// so "$($a.Replace("x","y"))" is not covered. -p:V="$($m.x)" lexes as the
-// parameter -p, a colon, and then the word V="$($m.x)".
-const WORD_SQ = /'[^']*'/.source;
-const WORD_DQ = /"([^"`]|`.)*"/.source;
-const WORD_ESC = /`[^\r\n]/.source;
-const ARGUMENT_ESC = /`[^\n]/.source;
-const PARAMETER_WORD = /-+/.source +
-  '(' + /[a-zA-Z_?\-]/.source + '|' + WORD_ESC + ')' +
-  '(' + /[a-zA-Z0-9_?\-]/.source + '|' + WORD_ESC + ')*';
-
-/**
- * The repeated tail of a command-line word.
- *
- * @param {string} plain regex source of one plain character
- */
-function wordTail(plain) {
-  return '(' + [plain, WORD_SQ, WORD_DQ, ARGUMENT_ESC].join('|') + ')*';
-}
-
-export default grammar({
-  name: 'powershell',
-
-  externals: ($) => [
-    $._statement_terminator,
-    $._bare_dashes,
-    $._method_block_head,
-    $._loose_dollar,
-  ],
-
-  extras: ($) => [
-    $.comment,
-    /\s/,
-    /`\n/,
-    /`\r\n/,
-    /[\uFEFF\u2060\u200B\u00A0]/,
-  ],
-
-  conflicts: ($) => [
-    [$._cast_operand, $.invokation_foreach_expression],
-    [$._literal, $.member_name],
-    [$.class_property_definition, $.attribute],
-    [$.class_method_definition, $.attribute],
-    [$.expandable_string_literal],
-    [$.path_command_name, $._value],
-    [$._statement, $.attribute],
-    // sloplint: `[T]` after a parameter comma may be the next
-    // parameter's attribute or a cast inside the default's array literal.
-    [$._cast_operand, $.member_access, $.invokation_expression],
-  ],
-
-  rules: {
