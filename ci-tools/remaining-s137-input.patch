-
-    // sloplint: numeric prefixes, exponents and multiplier suffixes are
-    // case-insensitive in PowerShell (0XFF, 1E3, 1MB, 10Gb).
-    decimal_integer_literal: ($) =>
-      token(
-        seq(
-          /[0-9]+/,
