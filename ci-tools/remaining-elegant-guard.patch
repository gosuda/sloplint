+      - name: "Compare every layout with Lean"
+        if: "!cancelled() && steps.engines.outcome == 'success' && steps.proofs.outcome == 'success'"
+        run: |
+          just lean-parity JOBS=4
+      - name: "Upload verification binaries"
+        if: "!cancelled() && steps.engines.outcome == 'success' && steps.proofs.outcome == 'success'"
+        uses: "actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f" # v7.0.0
