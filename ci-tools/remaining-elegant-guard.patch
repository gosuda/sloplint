+          echo "7289597a44543246c9227b8cae501767e095ce17f6d448b95fc4a8dc97268f6d  $RUNNER_TEMP/lean.tar.zst" | sha256sum --check
+          mkdir -p "$HOME/.cache/lean"
+          tar --zstd -xf "$RUNNER_TEMP/lean.tar.zst" --strip-components=1 -C "$HOME/.cache/lean"
+      - name: "Add the Lean toolchain to PATH"
+        id: "lean"
+        if: "!cancelled() && steps.tools.outcome == 'success'"
+        run: "echo \"$HOME/.cache/lean/bin\" >> \"$GITHUB_PATH\""
+      - name: "Save the pinned Lean toolchain"
+        if: "!cancelled() && steps.lean-install.outcome == 'success'"
+        uses: "actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9" # v6.1.0
+        with:
+          path: "~/.cache/lean"
+          key: "lean-${{ hashFiles('proofs/lean-toolchain') }}"
+      - name: "Restore the lake build cache"
+        id: "lake-cache"
+        if: "!cancelled() && steps.tools.outcome == 'success'"
+        uses: "actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9" # v6.1.0
+        with:
+          path: "proofs/.lake"
+          key: "lake-${{ hashFiles('proofs/lean-toolchain', 'proofs/lakefile.toml', 'proofs/lake-manifest.json') }}-${{ hashFiles('proofs/**/*.lean') }}"
+          restore-keys: |
+            lake-${{ hashFiles('proofs/lean-toolchain', 'proofs/lakefile.toml', 'proofs/lake-manifest.json') }}-
+            lake-
+      - name: "Build and audit every proof"
+        id: "proofs"
+        if: "!cancelled() && steps.lean.outcome == 'success'"
+        run: "just proofs"
+      - name: "Save the lake build cache"
+        if: "!cancelled() && steps.proofs.outcome == 'success' && steps.lake-cache.outputs.cache-hit != 'true'"
+        uses: "actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9" # v6.1.0
+        with:
+          path: "proofs/.lake"
+          key: "lake-${{ hashFiles('proofs/lean-toolchain', 'proofs/lakefile.toml', 'proofs/lake-manifest.json') }}-${{ hashFiles('proofs/**/*.lean') }}"
+      - name: "Check corpus verdicts"
+        if: "!cancelled() && steps.engines.outcome == 'success'"
+        run: |
+          just oracle JOBS=4
+      - name: "Check corpus engine parity"
+        if: "!cancelled() && steps.engines.outcome == 'success'"
+        run: |
+          just parity JOBS=4
+      - name: "Compare Markdown exports"
+        if: "!cancelled() && steps.engines.outcome == 'success'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          effective_gocacheprog="$(go env GOCACHEPROG)"
+          test -z "$effective_gocacheprog"
+          just --no-deps markdown-parity
+      - name: "Check generated layered graphs"
+        if: "!cancelled() && steps.engines.outcome == 'success'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          effective_gocacheprog="$(go env GOCACHEPROG)"
+          test -z "$effective_gocacheprog"
+          just --no-deps layered-random-check JOBS=4
+      - name: "Compare geometry kernels"
+        if: "!cancelled() && steps.engines.outcome == 'success' && steps.proofs.outcome == 'success'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          effective_gocacheprog="$(go env GOCACHEPROG)"
+          test -z "$effective_gocacheprog"
+          just --no-deps kernel-diff
+      - name: "Validate every corpus layout"
+        if: "!cancelled() && steps.engines.outcome == 'success' && steps.proofs.outcome == 'success'"
+        run: |
