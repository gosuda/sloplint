+RUN echo "nested-build-ok" > status.txt
+CMD ["cat", "/app/status.txt"]
+EOF
+
+docker build -t nested-test:latest .
+docker run --rm nested-test:latest
+# Output: nested-build-ok
+
+kill -INT $DIND_PID
