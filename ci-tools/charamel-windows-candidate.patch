diff --git a/test/melt/windows_console.ps1 b/test/melt/windows_console.ps1
new file mode 100644
--- /dev/null
+++ b/test/melt/windows_console.ps1
@@ -0,0 +1,300 @@
+param([Parameter(Mandatory = $true)][string]$Melt)
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+if ([Environment]::OSVersion.Platform -ne [PlatformID]::Win32NT) {
+    throw "This test requires a native Windows console."
+}
+$executable = [IO.Path]::GetFullPath($Melt)
+$root = Join-Path ([IO.Path]::GetTempPath()) ("charamel-console-" + [Guid]::NewGuid().ToString("N"))
+[IO.Directory]::CreateDirectory($root) | Out-Null
+
+Add-Type -TypeDefinition @'
+using System;
+using System.ComponentModel;
+using System.Diagnostics;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Text.RegularExpressions;
+using Microsoft.Win32.SafeHandles;
+
+public static class MeltConsoleProbe
+{
+    [StructLayout(LayoutKind.Sequential)]
+    public struct SecurityAttributes
+    {
+        public int Length;
+        public IntPtr Descriptor;
+        [MarshalAs(UnmanagedType.Bool)] public bool Inherit;
+    }
+
+    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+    public struct StartupInfo
+    {
+        public uint Size;
+        public string Reserved;
+        public string Desktop;
+        public string Title;
+        public uint X, Y, XSize, YSize, XCount, YCount, Fill, Flags;
+        public ushort Show, ReservedSize;
+        public IntPtr ReservedPointer, Input, Output, Error;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    public struct ProcessInfo
+    {
+        public IntPtr Process, Thread;
+        public uint ProcessId, ThreadId;
+    }
+
+    [StructLayout(LayoutKind.Explicit, Size = 20)]
+    public struct InputRecord
+    {
+        [FieldOffset(0)] public ushort EventType;
+        [FieldOffset(4)] public int Down;
+        [FieldOffset(8)] public ushort Repeat;
+        [FieldOffset(10)] public ushort VirtualKey;
+        [FieldOffset(12)] public ushort ScanCode;
+        [FieldOffset(14)] public ushort Character;
+        [FieldOffset(16)] public uint Control;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    public struct Coordinate
+    {
+        public short X, Y;
+    }
+
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool AllocConsole();
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool FreeConsole();
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool AttachConsole(uint processId);
+    [DllImport("kernel32.dll")] public static extern IntPtr GetConsoleWindow();
+    [DllImport("kernel32.dll")] public static extern IntPtr GetStdHandle(int role);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool SetStdHandle(int role, IntPtr handle);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool GetConsoleMode(IntPtr handle, out uint mode);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool SetConsoleMode(IntPtr handle, uint mode);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool FlushConsoleInputBuffer(IntPtr handle);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern uint GetFileType(IntPtr handle);
+    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
+    public static extern IntPtr CreateFileW(string path, uint access, uint sharing,
+        ref SecurityAttributes security, uint disposition, uint flags, IntPtr template);
+    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
+    public static extern bool CreateProcessW(string application, StringBuilder command,
+        IntPtr processSecurity, IntPtr threadSecurity, bool inherit, uint flags,
+        IntPtr environment, string directory, ref StartupInfo startup, out ProcessInfo process);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern uint WaitForSingleObject(IntPtr handle, uint timeout);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool GetExitCodeProcess(IntPtr process, out uint code);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool TerminateProcess(IntPtr process, uint code);
+    [DllImport("kernel32.dll", SetLastError = true)] public static extern bool CloseHandle(IntPtr handle);
+    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
+    public static extern bool WriteConsoleInputW(IntPtr input, InputRecord[] records, uint count, out uint written);
+    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
+    public static extern bool ReadConsoleOutputCharacterW(IntPtr output, StringBuilder text,
+        uint count, Coordinate at, out uint read);
+
+    private static void Native(bool success, string operation)
+    {
+        if (!success) throw new Win32Exception(Marshal.GetLastWin32Error(), operation);
+    }
+
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+
+    private static SafeFileHandle Open(string path, uint access, uint disposition)
+    {
+        SecurityAttributes security = new SecurityAttributes();
+        security.Length = Marshal.SizeOf(typeof(SecurityAttributes));
+        security.Inherit = true;
+        IntPtr raw = CreateFileW(path, access, 3, ref security, disposition, 0x80, IntPtr.Zero);
+        if (raw == new IntPtr(-1))
+            throw new Win32Exception(Marshal.GetLastWin32Error(), "CreateFileW " + path);
+        return new SafeFileHandle(raw, true);
+    }
+
+    private static string ReadShared(string path)
+    {
+        using (FileStream stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
+        using (StreamReader reader = new StreamReader(stream))
+            return reader.ReadToEnd();
+    }
+
+    private static string Quote(string value)
+    {
+        Require(value.IndexOf('"') < 0 && !value.EndsWith("\\", StringComparison.Ordinal),
+            "fixture paths must be files without quote characters");
+        return "\"" + value + "\"";
+    }
+
+    private static uint Wait(IntPtr process, uint milliseconds)
+    {
+        uint result = WaitForSingleObject(process, milliseconds);
+        if (result == 0xffffffff) throw new Win32Exception(Marshal.GetLastWin32Error(), "WaitForSingleObject");
+        return result;
+    }
+
+    private static void AwaitPrompt(IntPtr process, string errorPath)
+    {
+        Stopwatch elapsed = Stopwatch.StartNew();
+        while (elapsed.ElapsedMilliseconds < 15000)
+        {
+            if (ReadShared(errorPath).Contains("finish with Ctrl-Z, then Enter:")) return;
+            if (Wait(process, 20) == 0)
+                throw new InvalidOperationException("restore exited before hidden input prompt: " + ReadShared(errorPath));
+        }
+        throw new TimeoutException("restore did not display its hidden input prompt within 15 seconds");
+    }
+
+    private static void WriteKeys(IntPtr input, string text)
+    {
+        InputRecord[] events = new InputRecord[text.Length * 2];
+        for (int i = 0; i < text.Length; i++)
+        {
+            char character = text[i];
+            InputRecord down = new InputRecord();
+            down.EventType = 1;
+            down.Down = 1;
+            down.Repeat = 1;
+            down.Character = character;
+            down.VirtualKey = character == '\u001a' ? (ushort)0x5a : (ushort)Char.ToUpperInvariant(character);
+            down.Control = character == '\u001a' ? 0x8u : 0;
+            events[i * 2] = down;
+            down.Down = 0;
+            events[i * 2 + 1] = down;
+        }
+        uint written;
+        Native(WriteConsoleInputW(input, events, (uint)events.Length, out written), "WriteConsoleInputW");
+        Require(written == events.Length, "the console accepted only part of the key sequence");
+    }
+
+    private static void VerifySeed(string executable, string key)
+    {
+        ProcessStartInfo start = new ProcessStartInfo(executable, "backup " + Quote(key));
+        start.UseShellExecute = false;
+        start.CreateNoWindow = true;
+        start.RedirectStandardInput = true;
+        start.RedirectStandardOutput = true;
+        start.RedirectStandardError = true;
+        using (Process process = Process.Start(start))
+        {
+            Require(process != null, "backup process did not start");
+            process.StandardInput.Close();
+            var output = process.StandardOutput.ReadToEndAsync();
+            var error = process.StandardError.ReadToEndAsync();
+            if (!process.WaitForExit(15000))
+            {
+                process.Kill();
+                Require(process.WaitForExit(5000), "backup process did not exit after termination");
+                throw new TimeoutException("backup did not finish within 15 seconds");
+            }
+            string text = output.GetAwaiter().GetResult();
+            string failure = error.GetAwaiter().GetResult();
+            Require(process.ExitCode == 0, "backup rejected the restored key: " + failure);
+            string[] words = new string[24];
+            for (int i = 0; i < 23; i++) words[i] = "abandon";
+            words[23] = "art";
+            string expected = String.Join(" ", words);
+            Require(Regex.Replace(text.Trim(), @"\s+", " ") == expected, "restored key does not retain the zero-entropy test seed");
+        }
+    }
+
+    private static void Restore(string executable, string root)
+    {
+        string outputPath = Path.Combine(root, "restore.stdout");
+        string errorPath = Path.Combine(root, "restore.stderr");
+        string key = Path.Combine(root, "recovered_key");
+        using (SafeFileHandle input = Open("CONIN$", 0xc0000000, 3))
+        using (SafeFileHandle screen = Open("CONOUT$", 0xc0000000, 3))
+        using (SafeFileHandle output = Open(outputPath, 0x40000000, 2))
+        using (SafeFileHandle error = Open(errorPath, 0x40000000, 2))
+        {
+            IntPtr stdin = input.DangerousGetHandle();
+            uint original;
+            Native(GetConsoleMode(stdin, out original), "GetConsoleMode initial stdin");
+            uint initial = (original | 0x7u) & ~0x200u;
+            Native(SetConsoleMode(stdin, initial), "SetConsoleMode initial stdin");
+            Native(FlushConsoleInputBuffer(stdin), "FlushConsoleInputBuffer");
+            uint ignored;
+            Require(GetFileType(output.DangerousGetHandle()) == 1 &&
+                !GetConsoleMode(output.DangerousGetHandle(), out ignored),
+                "stdout fixture is not a redirected disk file");
+            ProcessInfo child = new ProcessInfo();
+            try
+            {
+                StartupInfo startup = new StartupInfo();
+                startup.Size = (uint)Marshal.SizeOf(typeof(StartupInfo));
+                startup.Flags = 0x100;
+                startup.Input = stdin;
+                startup.Output = output.DangerousGetHandle();
+                startup.Error = error.DangerousGetHandle();
+                Native(CreateProcessW(executable, new StringBuilder(Quote(executable) + " restore --output " + Quote(key)),
+                    IntPtr.Zero, IntPtr.Zero, true, 0, IntPtr.Zero, root, ref startup, out child), "CreateProcessW restore");
+                AwaitPrompt(child.Process, errorPath);
+                uint hidden;
+                Native(GetConsoleMode(stdin, out hidden), "GetConsoleMode at prompt");
+                Require(hidden == (initial & ~0x4u), "input console echo was not disabled independently of stdout");
+                string six = "abandon abandon abandon abandon abandon abandon";
+                string payload = six + "\r" + six + "\r" + six + "\r" +
+                    "abandon abandon abandon abandon abandon art\r\u001a\r";
+                WriteKeys(stdin, payload);
+                Require(Wait(child.Process, 15000) == 0, "restore did not finish after Ctrl-Z and Enter");
+                uint code;
+                Native(GetExitCodeProcess(child.Process, out code), "GetExitCodeProcess restore");
+                Require(code == 0, "restore failed: " + ReadShared(errorPath));
+                uint restored;
+                Native(GetConsoleMode(stdin, out restored), "GetConsoleMode after restore");
+                Require(restored == initial, "input console mode was not restored");
+                StringBuilder visible = new StringBuilder(4096);
+                uint read;
+                Native(ReadConsoleOutputCharacterW(screen.DangerousGetHandle(), visible, 4096, new Coordinate(), out read),
+                    "ReadConsoleOutputCharacterW");
+                Require(!visible.ToString().Contains("abandon"), "the console echoed the recovery phrase");
+                Require(!ReadShared(outputPath).Contains("abandon") && !ReadShared(errorPath).Contains("abandon"),
+                    "redirected output contains the recovery phrase");
+                Require(File.Exists(key), "restore did not write its key");
+                VerifySeed(executable, key);
+            }
+            finally
+            {
+                if (child.Process != IntPtr.Zero)
+                {
+                    if (Wait(child.Process, 0) != 0)
+                    {
+                        Native(TerminateProcess(child.Process, 137), "TerminateProcess restore");
+                        Require(Wait(child.Process, 5000) == 0, "restore process survived termination");
+                    }
+                    Native(CloseHandle(child.Process), "CloseHandle process");
+                }
+                if (child.Thread != IntPtr.Zero) Native(CloseHandle(child.Thread), "CloseHandle thread");
+                Native(SetConsoleMode(stdin, original), "restore fixture console mode");
+            }
+        }
+    }
+
+    public static void Run(string executable, string root)
+    {
+        IntPtr savedInput = GetStdHandle(-10), savedOutput = GetStdHandle(-11), savedError = GetStdHandle(-12);
+        bool attached = GetConsoleWindow() != IntPtr.Zero;
+        if (attached) Native(FreeConsole(), "FreeConsole inherited console");
+        Native(AllocConsole(), "AllocConsole test console");
+        try { Restore(executable, root); }
+        finally
+        {
+            Native(FreeConsole(), "FreeConsole test console");
+            if (attached) Native(AttachConsole(0xffffffff), "AttachConsole parent");
+            Native(SetStdHandle(-10, savedInput), "restore standard input handle");
+            Native(SetStdHandle(-11, savedOutput), "restore standard output handle");
+            Native(SetStdHandle(-12, savedError), "restore standard error handle");
+        }
+    }
+}
+'@
+
+try {
+    [MeltConsoleProbe]::Run($executable, $root)
+    Write-Output "PASS: native console input, redirected stdout, hidden multiline phrase, Ctrl-Z EOF, restored console mode, exact recovered seed"
+}
+finally {
+    Remove-Item -LiteralPath $root -Recurse -Force
+}
