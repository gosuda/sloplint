+
+func checkH3Reply(t *testing.T, client *http.Client, origin string, want h3ReplyCase) {
+	t.Helper()
+	resp, err := client.Get(origin + want.path)
+	if err != nil {
+		t.Fatalf("GET %s: %v", want.path, err)
+		return
+	}
+	defer func() {
+		if err := resp.Body.Close(); err != nil {
+			t.Errorf("close response: %v", err)
+		}
+	}()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatalf("read %s: %v", want.path, err)
+		return
+	}
+	if resp.StatusCode != want.status || resp.Header.Get("Content-Type") != want.contentType {
+		t.Fatalf("%s: status %d, content type %q", want.path, resp.StatusCode, resp.Header.Get("Content-Type"))
+	}
+	if resp.Header.Get("X-Test-Stage") != "ran" || !strings.Contains(string(body), want.bodyPart) {
+		t.Fatalf("%s: stage %q, body %q", want.path, resp.Header.Get("X-Test-Stage"), body)
+	}
+}
