+func releaseH3RetryPort(ctx context.Context, packet net.PacketConn, attempt int) error {
+	timer := time.NewTimer(time.Duration(attempt)*10*time.Millisecond - 5*time.Millisecond)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		if err := packet.Close(); err != nil {
+			return fmt.Errorf("release UDP before retry %d: %w", attempt, err)
+		}
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func driveH3RetryInterval(ctx context.Context, probe *h3ConflictProbe, attempt int) error {
+	if attempt == 0 {
+		if err := probe.packet.Close(); err != nil {
+			return fmt.Errorf("release UDP before initial bind: %w", err)
+		}
+		return startH3DuringConflict(ctx, probe)
+	}
+	go group (ctx) {
+		go startH3DuringConflict(ctx, probe)
+		go releaseH3RetryPort(ctx, probe.packet, attempt)
+	}
+	return nil
+}
