+func TestH3StartRetriesAtEveryInterval(t *testing.T) {
+	for attempt := 0; attempt < 8; attempt++ {
+		t.Run(fmt.Sprintf("attempt-%d", attempt), func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				tcp, packet := bindH3CallerSockets(t)
+				defer closeH3CallerSockets(t, tcp, packet)
+				cert, _ := testCert(t)
+				server := &http3.Server{Addr: tcp.Addr().String(), Router: web.NewRouter(), TLS: &tls.Config{Certificates: []tls.Certificate{cert}}, H3: true}
+				defer stopH3Server(t, server)
+				ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
+				defer cancel()
+				probe := &h3ConflictProbe{server: server, packet: packet, result: make(chan error, 1)}
+				started := time.Now()
+				if err := driveH3RetryInterval(ctx, probe, attempt); err != nil {
+					t.Fatalf("retry %d probe: %v", attempt, err)
+					return
+				}
+				elapsed := time.Since(started)
+				select {
+				case err := <-probe.result:
+					op, ok := errors.AsType[*net.OpError](err)
+					if !ok || op.Op != "listen" || op.Net != "tcp" || !errors.Is(err, syscall.EADDRINUSE) {
+						t.Fatalf("retry %d = %v, want TCP listen EADDRINUSE after UDP release", attempt, err)
+						return
+					}
+				case <-ctx.Done():
+					t.Fatalf("retry %d returned no result: %v", attempt, ctx.Err())
+					return
+				}
+				if want := time.Duration(attempt) * 10 * time.Millisecond; elapsed != want {
+					t.Fatalf("retry %d reached TCP conflict after %v, want %v", attempt, elapsed, want)
+				}
+			})
+		})
+	}
+}
