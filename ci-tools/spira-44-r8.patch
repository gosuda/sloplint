+func h3CallerServeSuccess(t *testing.T) {
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	router := web.NewRouter()
+	router.Handle("GET", "/hello", h3Hello)
+	server := &http3.Server{Router: router, TLS: &tls.Config{Certificates: []tls.Certificate{cert}}, H3: true, ShutdownGrace: 10 * time.Second}
+	listener, packet := bindH3CallerSockets(t)
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	if err := server.Serve(ctx, listener, packet); err != nil {
+		cerr := errors.Join(listener.Close(), packet.Close())
+		t.Fatalf("serve over caller sockets: %v; close caller sockets: %v", err, cerr)
+		return
+	}
+	t.Cleanup(func() {
+		if cerr := listener.Close(); !errors.Is(cerr, net.ErrClosed) {
+			t.Errorf("caller TCP listener after Stop: %v, want a closed socket", cerr)
+		}
+		if cerr := packet.Close(); !errors.Is(cerr, net.ErrClosed) {
+			t.Errorf("caller UDP connection after Stop: %v, want a closed socket", cerr)
+		}
+	})
+	t.Cleanup(func() {
+		stopCtx, stopCancel := context.WithTimeout(context.Background(), 30*time.Second)
+		defer stopCancel()
+		if err := server.Stop(stopCtx); err != nil {
+			t.Errorf("stop caller-socket server: %v", err)
+		}
+	})
+	tcpAddr := listener.Addr().String()
+	udpAddr := packet.LocalAddr().String()
+	if got := server.BoundTCPAddrForTest(); got != tcpAddr {
+		t.Fatalf("server recorded caller TCP %q, want %q", got, tcpAddr)
+		return
+	}
+	if got := server.BoundUDPAddrForTest(); got != udpAddr {
+		t.Fatalf("server recorded caller UDP %q, want %q", got, udpAddr)
+		return
+	}
+	code, body, tcpProto := httpsGetFull(t, pool, "https://"+tcpAddr+"/hello")
+	if code != http.StatusOK || !strings.Contains(body, `"hi"`) || (tcpProto != "HTTP/2.0" && tcpProto != "HTTP/1.1") {
+		t.Fatalf("caller TCP answer status %d proto %q body %q", code, tcpProto, body)
+		return
+	}
+	tr := http3peer.NewTransport(&tls.Config{RootCAs: pool})
+	t.Cleanup(func() { closeH3Transport(t, tr) })
+	status, h3Proto, h3Body := h3Get(t, tr, "https://"+udpAddr+"/hello")
+	if status != http.StatusOK || h3Proto != "HTTP/3.0" || !strings.Contains(h3Body, `"hi"`) {
+		t.Fatalf("caller UDP answer status %d proto %q body %q", status, h3Proto, h3Body)
+		return
+	}
+}
