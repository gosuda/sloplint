+func assertH3CallerSocketsUsable(t *testing.T, listener net.Listener, packet net.PacketConn) {
+	t.Helper()
+	assertH3CallerListenerAccepts(t, listener)
+	assertH3CallerPacketRoundTrips(t, packet)
+}
+
+func assertH3CallerListenerAccepts(t *testing.T, listener net.Listener) {
+	t.Helper()
+	tcp, ok := listener.(*net.TCPListener)
+	if !ok {
+		t.Fatalf("caller listener type %T, want *net.TCPListener", listener)
+		return
+	}
+	if serr := tcp.SetDeadline(time.Now().Add(2 * time.Second)); serr != nil {
+		t.Fatalf("set caller TCP accept deadline: %v", serr)
+		return
+	}
+	probe, derr := net.DialTimeout("tcp", listener.Addr().String(), 2*time.Second)
+	if derr != nil {
+		t.Fatalf("caller TCP listener refuses connections: %v", derr)
+		return
+	}
+	accepted, aerr := tcp.Accept()
+	if aerr != nil {
+		cerr := probe.Close()
+		t.Fatalf("caller TCP listener did not accept the probe: %v; close probe: %v", aerr, cerr)
+		return
+	}
+	if cerr := accepted.Close(); cerr != nil {
+		t.Errorf("close accepted caller probe: %v", cerr)
+	}
+	if cerr := probe.Close(); cerr != nil {
+		t.Errorf("close caller TCP probe: %v", cerr)
+	}
+	if serr := tcp.SetDeadline(time.Time{}); serr != nil && !errors.Is(serr, net.ErrClosed) {
+		t.Errorf("clear caller TCP accept deadline: %v", serr)
+	}
+}
+
+func assertH3CallerPacketRoundTrips(t *testing.T, packet net.PacketConn) {
+	t.Helper()
+	if serr := packet.SetDeadline(time.Now().Add(2 * time.Second)); serr != nil {
+		t.Fatalf("set caller UDP deadline: %v", serr)
+		return
+	}
+	defer func() {
+		if serr := packet.SetDeadline(time.Time{}); serr != nil && !errors.Is(serr, net.ErrClosed) {
+			t.Errorf("clear caller UDP deadline: %v", serr)
+		}
+	}()
+	probe := []byte("caller-probe")
+	if _, werr := packet.WriteTo(probe, packet.LocalAddr()); werr != nil {
+		t.Fatalf("caller UDP connection refused the write: %v", werr)
+		return
+	}
+	buf := make([]byte, len(probe))
+	n, _, rerr := packet.ReadFrom(buf)
+	if rerr != nil {
+		t.Fatalf("caller UDP connection did not receive its own datagram: %v", rerr)
+		return
+	}
+	if string(buf[:n]) != string(probe) {
+		t.Fatalf("caller UDP datagram = %q, want %q", buf[:n], probe)
+		return
+	}
+}
