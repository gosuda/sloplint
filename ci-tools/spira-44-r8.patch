-func seedH3EarlySession(ctx context.Context, serverTLS *tls.Config, clientTLS *tls.Config, ready <-chan *tls.ClientSessionState) error {
-	socket := net.ListenPacket("udp4", "127.0.0.1:0")?
-	defer socket.Close()?
-	transport := &quic.Transport{Conn: socket}
-	defer transport.Close()?
-	listener := transport.ListenEarly(serverTLS, &quic.Config{
-		Allow0RTT: true, RequireStreamCreditRelease: true,
-		MaxIncomingStreams: 1, MaxIncomingUniStreams: 1,
-	})?
-	defer listener.Close()?
-	conn := quic.DialAddr(ctx, listener.Addr().String(), clientTLS, &quic.Config{Versions: []quic.Version{quic.Version1}})?
-	defer conn.CloseWithError(0, "")?
-	select {
-	case ticket := <-ready:
-		_, state := ticket.ResumptionState()?
-		if state == nil || !state.EarlyData {
-			return errors.New("seed server did not issue an early-data ticket")
-		}
-		return nil
-	case <-ctx.Done():
-		return fmt.Errorf("wait for TLS session ticket: %w", ctx.Err())
-	}
-}
