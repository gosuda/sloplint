+type h3SlowProbe struct {
+	entered  chan struct{}
+	release  chan struct{}
+	status   sync.Locked[int]
+	fetchErr sync.Locked[error]
+	stopErr  sync.Locked[error]
+	stopDur  sync.Locked[time.Duration]
+}
+
+type h3StuckProbe struct {
+	entered    chan struct{}
+	release    chan struct{}
+	stopWithin time.Duration = time.Minute
+	stopErr    sync.Locked[error]
+	stopDur    sync.Locked[time.Duration]
+}
+
+func h3SlowHandler(p *h3SlowProbe) web.Handler {
+	return func(ctx *web.Context) (web.Reply, error) {
+		close(p.entered)
+		select {
+		case <-p.release:
+		case <-ctx.Ctx().Done():
+			return nil, fmt.Errorf("http3 test: request context ended: %w", ctx.Ctx().Err())
+		}
+		return web.Empty{}, nil
+	}
+}
+
+func h3StuckHandler(p *h3StuckProbe) web.Handler {
+	return func(ctx *web.Context) (web.Reply, error) {
+		close(p.entered)
+		select {
+		case <-p.release:
+		case <-ctx.Ctx().Done():
+			return nil, fmt.Errorf("http3 test: request context ended: %w", ctx.Ctx().Err())
+		}
+		return web.Empty{}, nil
+	}
+}
+
+func waitH3Entered(ctx context.Context, entered chan struct{}) error {
+	select {
+	case <-entered:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func fetchH3Slow(ctx context.Context, tr h3CloseableTransport, url string, p *h3SlowProbe) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		p.fetchErr.WithLock(func(e *error) { *e = fmt.Errorf("http3 test: build: %w", err) })
+		return nil
+	}
+	resp, err := tr.RoundTrip(req)
+	if err != nil {
+		p.fetchErr.WithLock(func(e *error) { *e = fmt.Errorf("http3 test: do: %w", err) })
+		return nil
+	}
+	defer func() {
+		if cerr := resp.Body.Close(); cerr != nil {
+			return
+		}
+	}()
+	if _, rerr := io.ReadAll(resp.Body); rerr != nil {
+		p.fetchErr.WithLock(func(e *error) { *e = fmt.Errorf("http3 test: read: %w", rerr) })
+		return nil
+	}
+	p.status.WithLock(func(v *int) { *v = resp.StatusCode })
+	if cerr := tr.Close(); cerr != nil {
+		p.fetchErr.WithLock(func(e *error) { *e = fmt.Errorf("http3 test: close transport: %w", cerr) })
+	}
+	return nil
+}
+
+func stopH3Slow(ctx context.Context, s *http3.Server, p *h3SlowProbe) error {
+	if err := waitH3Entered(ctx, p.entered); err != nil {
+		return err
+	}
+	start := time.Now()
+	p.stopErr.WithLock(func(e *error) { *e = s.Stop(ctx) })
+	p.stopDur.WithLock(func(d *time.Duration) { *d = time.Since(start) })
+	return nil
+}
+
+func releaseH3Slow(ctx context.Context, p *h3SlowProbe) error {
+	if err := waitH3Entered(ctx, p.entered); err != nil {
+		return err
+	}
+	time.Sleep(50 * time.Millisecond)
+	close(p.release)
+	return nil
+}
+
+type h3Target struct {
+	tr  h3CloseableTransport
+	url string
+}
+
+func driveH3Slow(ctx context.Context, target h3Target, s *http3.Server, p *h3SlowProbe) error {
+	go group (ctx) {
+		go fetchH3Slow(ctx, target.tr, target.url, p)
+		go stopH3Slow(ctx, s, p)
+		go releaseH3Slow(ctx, p)
+	}
+	return nil
+}
+
+func fetchH3Stuck(ctx context.Context, tr http.RoundTripper, url string) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return nil
+	}
+	resp, err := tr.RoundTrip(req)
+	if err != nil {
+		return nil
+	}
+	defer func() {
+		if cerr := resp.Body.Close(); cerr != nil {
+			return
+		}
+	}()
+	return nil
+}
+
+func stopH3Stuck(ctx context.Context, s *http3.Server, p *h3StuckProbe) error {
+	if err := waitH3Entered(ctx, p.entered); err != nil {
+		p.stopErr.WithLock(func(e *error) { *e = fmt.Errorf("http3 test: wait entered: %w", err) })
+		return nil
+	}
+	time.Sleep(50 * time.Millisecond)
+	stopCtx, cancel := context.WithTimeout(ctx, p.stopWithin)
+	defer cancel()
+	start := time.Now()
+	p.stopErr.WithLock(func(e *error) { *e = s.Stop(stopCtx) })
+	p.stopDur.WithLock(func(d *time.Duration) { *d = time.Since(start) })
+	close(p.release)
+	return nil
+}
+
+func driveH3Stuck(ctx context.Context, target h3Target, s *http3.Server, p *h3StuckProbe) error {
+	go group (ctx) {
+		go fetchH3Stuck(ctx, target.tr, target.url)
+		go stopH3Stuck(ctx, s, p)
+	}
+	return nil
+}
