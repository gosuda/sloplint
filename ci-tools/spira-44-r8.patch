+func TestH3RefusesEarlyData(t *testing.T) {
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	var key [32]byte
+	if _, err := rand.Read(key[:]); err != nil {
+		t.Fatalf("generate session ticket key: %v", err)
+		return
+	}
+	issuerTLS := &tls.Config{Certificates: []tls.Certificate{cert}, NextProtos: []string{"h3"}, MinVersion: tls.VersionTLS13}
+	issuerTLS.SetSessionTicketKeys([][32]byte{key})
+	cache := &h3EarlySessionCache{ClientSessionCache: tls.NewLRUClientSessionCache(1), ready: make(chan *tls.ClientSessionState, 1)}
+	clientTLS := &tls.Config{RootCAs: pool, ServerName: "example.com", NextProtos: []string{"h3"}, ClientSessionCache: cache}
+	if err := seedH3EarlySession(ctx, issuerTLS, clientTLS, cache.ready); err != nil {
+		t.Fatalf("seed a resumption ticket: %v", err)
+		return
+	}
+	sent := make(chan struct{})
+	targetTLS := issuerTLS.Clone()
+	targetTLS.GetConfigForClient = func(_ *tls.ClientHelloInfo) (*tls.Config, error) {
+		select {
+		case <-sent:
+			return issuerTLS, nil
+		case <-ctx.Done():
+			return issuerTLS, ctx.Err()
+		}
+	}
+	server := &http3.Server{Addr: "127.0.0.1:0", Router: web.NewRouter(), TLS: targetTLS, H3: true, ShutdownGrace: 2 * time.Second}
+	if err := server.Start(ctx); err != nil {
+		t.Fatalf("start HTTP/3 server: %v", err)
+		return
+	}
+	t.Cleanup(func() { stopH3Server(t, server) })
+	if err := attemptH3EarlyData(ctx, server.BoundUDPAddrForTest(), clientTLS, sent); err != nil {
+		t.Fatalf("probe HTTP/3 early data: %v", err)
+	}
+}
