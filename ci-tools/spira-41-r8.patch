+func TestOpenHonorsSecondIdleTimeout(t *testing.T) {
+	pool := openSplitPool(t, "idle-timeout.db",
+		db.PoolOptions{MaxOpenConns: 2},
+		db.PoolOptions{ConnMaxIdleTime: time.Nanosecond},
+	)
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	ticker := time.NewTicker(10 * time.Millisecond)
+	defer ticker.Stop()
+	for pool.Stats().MaxIdleTimeClosed == 0 {
+		select {
+		case <-ticker.C:
+		case <-ctx.Done():
+			t.Fatalf("second idle timeout was ignored: %+v", pool.Stats())
+			return
+		}
+	}
+	if pool.Stats().MaxLifetimeClosed != 0 {
+		t.Fatal("lifetime expiry masked the idle-timeout assertion")
+	}
+}
