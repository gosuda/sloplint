+func TestPlainFilenameMemoryQueryKeepsExpiry(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "plain.db")
+	pool := openRawPool(t, path+"?mode=memory",
+		db.PoolOptions{ConnMaxLifetime: time.Nanosecond})
+	execKeep(t, pool, "CREATE TABLE keep (n integer not null)")
+	execKeep(t, pool, "INSERT INTO keep (n) VALUES (1)")
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	if n := countKeepRows(t, ctx, pool); n != 1 {
+		t.Fatalf("file-backed rows = %d, want 1", n)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("plain filename did not open a real file: %v", err)
+	}
+	if pool.Stats().MaxLifetimeClosed == 0 {
+		t.Fatal("plain filename query disabled connection expiry")
+	}
+}
+
+func TestMemoryURIFragmentKeepsRows(t *testing.T) {
+	pool := openRawPool(t, "file:spira_keep_fragment?cache=shared&mode=memory#shop",
+		db.PoolOptions{MaxOpenConns: 1, ConnMaxLifetime: time.Nanosecond})
+	execKeep(t, pool, "CREATE TABLE keep (n integer not null)")
+	execKeep(t, pool, "INSERT INTO keep (n) VALUES (1)")
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	if n := countKeepRows(t, ctx, pool); n != 1 {
+		t.Fatalf("fragmented memory URI lost rows: %d", n)
+	}
+	if pool.Stats().MaxLifetimeClosed != 0 {
+		t.Fatal("fragmented memory URI allowed connection expiry")
+	}
+}
