index 0000000..d5cb008
--- /dev/null
+++ b/http3/timeouts_test.lgo
@@ -0,0 +1,329 @@
+package http3_test
+
+import (
+	"bufio"
+	"context"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/quic-go/quic-go"
+	"github.com/gosuda/spira/http3"
+	"github.com/gosuda/spira/web"
+)
+
+func stopH3TimeoutServer(t *testing.T, s *http3.Server) {
+	t.Helper()
+	t.Cleanup(func() {
+		cctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		if err := s.Stop(cctx); err != nil {
+			t.Errorf("cleanup stop: %v", err)
+		}
+	})
+}
+
+func dialStalledTCPBody(t *testing.T, addr string, request string) net.Conn {
+	t.Helper()
+	conn, derr := net.DialTimeout("tcp", addr, 5*time.Second)
+	if derr != nil {
+		t.Fatalf("dial: %v", derr)
+		return nil
+	}
+	if derr := conn.SetWriteDeadline(time.Now().Add(5 * time.Second)); derr != nil {
+		t.Fatalf("set write deadline: %v", derr)
+		return nil
+	}
+	if _, werr := fmt.Fprintf(conn, "%s", request); werr != nil {
+		t.Fatalf("write request head: %v", werr)
+		return nil
+	}
+	if derr := conn.SetReadDeadline(time.Now().Add(5 * time.Second)); derr != nil {
+		t.Fatalf("set read deadline: %v", derr)
+		return nil
+	}
+	return conn
+}
+
+func dialStalledTLSBody(t *testing.T, addr string, request string) net.Conn {
+	t.Helper()
+	dialer := &net.Dialer{Timeout: 5 * time.Second}
+	var conn net.Conn
+	var derr error
+	config := &tls.Config{InsecureSkipVerify: true, ServerName: "example.com"}
+	conn, derr = tls.DialWithDialer(dialer, "tcp", addr, config)
+	if derr != nil {
+		t.Fatalf("dial: %v", derr)
+		return nil
+	}
+	if derr := conn.SetWriteDeadline(time.Now().Add(5 * time.Second)); derr != nil {
+		t.Fatalf("set write deadline: %v", derr)
+		return nil
+	}
+	if _, werr := fmt.Fprintf(conn, "%s", request); werr != nil {
+		t.Fatalf("write request head: %v", werr)
+		return nil
+	}
+	if derr := conn.SetReadDeadline(time.Now().Add(5 * time.Second)); derr != nil {
+		t.Fatalf("set read deadline: %v", derr)
+		return nil
+	}
+	return conn
+}
+
+func TestH3TCPClosesSlowBodyWithinReadTimeout(t *testing.T) {
+	r := web.NewRouter()
+	handlerDone := make(chan struct{})
+	r.Handle("POST", "/echo", func(ctx *web.Context) (web.Reply, error) {
+		data, rerr := web.ReadBody(ctx.Request, 1024)
+		if rerr != nil {
+			return web.Problem{Title: "body read failed", Status: http.StatusBadRequest}, nil
+		}
+		close(handlerDone)
+		return web.Data{Value: string(data)}, nil
+	})
+	s := &http3.Server{Addr: "127.0.0.1:0", Router: r, ReadTimeout: 300 * time.Millisecond, ShutdownGrace: 2 * time.Second}
+	if err := s.Start(context.Background()); err != nil {
+		t.Fatalf("start: %v", err)
+		return
+	}
+	stopH3TimeoutServer(t, s)
+	addr := s.BoundTCPAddrForTest()
+	if addr == "" {
+		t.Fatal("the started server bound no TCP address")
+		return
+	}
+	conn := dialStalledTCPBody(t, addr, $"POST /echo HTTP/1.1\r\nHost: {addr}\r\nContent-Length: 8\r\n\r\nab")
+	defer func() {
+		if cerr := conn.Close(); cerr != nil {
+			return
+		}
+	}()
+	start := time.Now()
+	_, rerr := io.ReadAll(conn)
+	elapsed := time.Since(start)
+	if elapsed > 2*time.Second {
+		t.Fatalf("stalled body stayed open %v past the 300ms read timeout", elapsed)
+		return
+	}
+	if rerr != nil && strings.Contains(rerr.Error(), "i/o timeout") {
+		t.Fatalf("stalled body kept the connection open until the test deadline: %v", rerr)
+		return
+	}
+	select {
+	case <-handlerDone:
+		t.Fatal("the handler completed although the body never finished")
+	default:
+	}
+}
+
+func TestH3TCPClosesIdleConnectionAfterIdleTimeout(t *testing.T) {
+	r := web.NewRouter()
+	r.Handle("GET", "/hello", h3Hello)
+	s := &http3.Server{Addr: "127.0.0.1:0", Router: r, IdleTimeout: 300 * time.Millisecond, ShutdownGrace: 2 * time.Second}
+	if err := s.Start(context.Background()); err != nil {
+		t.Fatalf("start: %v", err)
+		return
+	}
+	stopH3TimeoutServer(t, s)
+	addr := s.BoundTCPAddrForTest()
+	if addr == "" {
+		t.Fatal("the started server bound no TCP address")
+		return
+	}
+	conn := dialStalledTCPBody(t, addr, $"GET /hello HTTP/1.1\r\nHost: {addr}\r\n\r\n")
+	defer func() {
+		if cerr := conn.Close(); cerr != nil {
+			return
+		}
+	}()
+	bufr := bufio.NewReader(conn)
+	res, rerr := http.ReadResponse(bufr, &http.Request{Method: "GET"})
+	if rerr != nil {
+		t.Fatalf("read response: %v", rerr)
+		return
+	}
+	body, berr := io.ReadAll(res.Body)
+	if cerr := res.Body.Close(); cerr != nil {
+		t.Errorf("close response body: %v", cerr)
+	}
+	if berr != nil || !strings.Contains(string(body), "hi") {
+		t.Fatalf("first answer body = %q, %v", body, berr)
+		return
+	}
+	start := time.Now()
+	if _, rerr = bufr.ReadByte(); rerr == nil {
+		t.Fatal("idle connection received a byte instead of a close")
+		return
+	}
+	if elapsed := time.Since(start); elapsed > 2*time.Second {
+		t.Fatalf("idle connection stayed open %v past the 300ms idle timeout", elapsed)
+		return
+	}
+}
+
+func TestH3ServeClosesSlowBodyWithinReadTimeout(t *testing.T) {
+	r := web.NewRouter()
+	handlerDone := make(chan struct{})
+	r.Handle("POST", "/echo", func(ctx *web.Context) (web.Reply, error) {
+		data, rerr := web.ReadBody(ctx.Request, 1024)
+		if rerr != nil {
+			return web.Problem{Title: "body read failed", Status: http.StatusBadRequest}, nil
+		}
+		close(handlerDone)
+		return web.Data{Value: string(data)}, nil
+	})
+	cert, _ := testCert(t)
+	listener, packet := bindH3CallerSockets(t)
+	s := &http3.Server{Router: r, TLS: &tls.Config{Certificates: []tls.Certificate{cert}}, H3: true, ReadTimeout: 300 * time.Millisecond, ShutdownGrace: 2 * time.Second}
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	if err := s.Serve(ctx, listener, packet); err != nil {
+		cerr := errors.Join(listener.Close(), packet.Close())
+		t.Fatalf("serve over caller sockets: %v; close caller sockets: %v", err, cerr)
+		return
+	}
+	stopH3TimeoutServer(t, s)
+	addr := listener.Addr().String()
+	conn := dialStalledTLSBody(t, addr, $"POST /echo HTTP/1.1\r\nHost: {addr}\r\nContent-Length: 8\r\n\r\nab")
+	defer func() {
+		if cerr := conn.Close(); cerr != nil {
+			return
+		}
+	}()
+	start := time.Now()
+	_, rerr := io.ReadAll(conn)
+	elapsed := time.Since(start)
+	if elapsed > 2*time.Second {
+		t.Fatalf("stalled body stayed open %v past the 300ms read timeout", elapsed)
+		return
+	}
+	if rerr != nil && strings.Contains(rerr.Error(), "i/o timeout") {
+		t.Fatalf("stalled body kept the connection open until the test deadline: %v", rerr)
+		return
+	}
+	select {
+	case <-handlerDone:
+		t.Fatal("the handler completed although the body never finished")
+	default:
+	}
+}
+
+func sendH3ClientSettings(t *testing.T, conn *quic.Conn) {
+	t.Helper()
+	settings, serr := conn.OpenUniStream()
+	if serr != nil {
+		t.Fatalf("open control stream: %v", serr)
+		return
+	}
+	t.Cleanup(func() {
+		if cerr := settings.Close(); cerr != nil {
+			t.Errorf("close control stream: %v", cerr)
+		}
+	})
+	if derr := settings.SetWriteDeadline(time.Now().Add(5 * time.Second)); derr != nil {
+		t.Fatalf("set control write deadline: %v", derr)
+		return
+	}
+	if _, werr := settings.Write([]byte{0x00, 0x04, 0x00}); werr != nil {
+		t.Fatalf("write client SETTINGS: %v", werr)
+		return
+	}
+}
+
+func TestH3QUICClosesIdleConnectionAfterSettings(t *testing.T) {
+	r := web.NewRouter()
+	r.Handle("GET", "/hello", h3Hello)
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	s := startH3Server(t, r, cert, 2*time.Second)
+	if s == nil {
+		t.Fatal("server did not start")
+		return
+	}
+	udpAddr := s.BoundUDPAddrForTest()
+	if udpAddr == "" {
+		t.Fatal("no UDP bound address")
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Second)
+	defer cancel()
+	conn, derr := quic.DialAddr(ctx, udpAddr, &tls.Config{RootCAs: pool, ServerName: "example.com", NextProtos: []string{"h3"}}, &quic.Config{})
+	if derr != nil {
+		t.Fatalf("quic dial: %v", derr)
+		return
+	}
+	defer func() {
+		if cerr := conn.CloseWithError(0, ""); cerr != nil {
+			return
+		}
+	}()
+	select {
+	case <-conn.HandshakeComplete():
+	case <-conn.Context().Done():
+		t.Fatalf("QUIC connection closed before the handshake finished: %v", context.Cause(conn.Context()))
+		return
+	case <-ctx.Done():
+		t.Fatalf("QUIC handshake did not finish: %v", ctx.Err())
+		return
+	}
+	sendH3ClientSettings(t, conn)
+	select {
+	case <-conn.Context().Done():
+		cause := context.Cause(conn.Context())
+		idle, ok := errors.AsType[*quic.IdleTimeoutError](cause)
+		if !ok || idle == nil {
+			t.Fatalf("post-SETTINGS close = %v, want a QUIC idle timeout", cause)
+			return
+		}
+	case <-ctx.Done():
+		t.Fatal("QUIC connection stayed open past the idle bound after SETTINGS")
+		return
+	}
+}
+
+func TestH3QUICMissingSettingsReportsProtocolCode(t *testing.T) {
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	s := startH3Server(t, web.NewRouter(), cert, 2*time.Second)
+	if s == nil {
+		t.Fatal("server did not start")
+		return
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 12*time.Second)
+	defer cancel()
+	conn, err := quic.DialAddr(ctx, s.BoundUDPAddrForTest(),
+		&tls.Config{RootCAs: pool, ServerName: "example.com", NextProtos: []string{"h3"}},
+		&quic.Config{MaxIdleTimeout: 20 * time.Second})
+	if err != nil {
+		t.Fatalf("QUIC handshake: %v", err)
+		return
+	}
+	defer func() {
+		if err := conn.CloseWithError(0, ""); err != nil {
+			return
+		}
+	}()
+	select {
+	case <-conn.Context().Done():
+		cause := context.Cause(conn.Context())
+		protocol, ok := errors.AsType[*quic.ApplicationError](cause)
+		if !ok || protocol == nil || !protocol.Remote || protocol.ErrorCode != 0x10a {
+			t.Fatalf("missing SETTINGS closed with %v, want remote H3_MISSING_SETTINGS", cause)
+		}
+	case <-ctx.Done():
+		t.Fatal("server did not report missing SETTINGS before the test deadline")
+	}
+}
