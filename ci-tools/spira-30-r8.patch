-func stopH3AtGrace(ctx context.Context, s *http3.Server, p *h3GraceProbe) error {
-	defer close(p.stopped)
-	if err := waitH3Entered(ctx, p.entered); err != nil {
-		return fmt.Errorf("HTTP/3 handler did not enter: %w", err)
-	}
-	stopCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
-	defer cancel()
-	started := time.Now()
-	err := s.Stop(stopCtx)
-	if elapsed := time.Since(started); elapsed < s.ShutdownGrace {
-		if err != nil {
-			return fmt.Errorf("Stop returned in %v before ShutdownGrace %v: %w", elapsed, s.ShutdownGrace, err)
-		}
-		return fmt.Errorf("Stop reported success in %v before ShutdownGrace %v", elapsed, s.ShutdownGrace)
-	}
-	if stopCtx.Err() != nil {
-		return fmt.Errorf("Stop reached the caller deadline: %w", stopCtx.Err())
-	}
-	if err == nil {
-		return fmt.Errorf("Stop reported success after ShutdownGrace %v with an active HTTP/3 request", s.ShutdownGrace)
-	}
-	return nil
-}
