+package http3_test
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/gosuda/spira/http3"
+	"github.com/gosuda/spira/internal/http3peer"
+	"github.com/gosuda/spira/web"
+)
+
+type heldClosedPacketReader struct {
+	net.PacketConn
+	hold    context.Context
+	release context.CancelFunc
+	entered chan struct{}
+	exited  chan struct{}
+}
+
+func (p *heldClosedPacketReader) ReadFrom(buffer []byte) (int, net.Addr, error) {
+	n, addr, err := p.PacketConn.ReadFrom(buffer)
+	if !errors.Is(err, net.ErrClosed) {
+		return n, addr, err
+	}
+	close(p.entered)
+	<-p.hold.Done()
+	close(p.exited)
+	return n, addr, err
+}
+
+func stopWithPacketReaderHeld(ctx context.Context, p *deadlineProbe, packet *heldClosedPacketReader, endFetch context.CancelFunc) error {
+	defer packet.release()
+	defer endFetch()
+	if err := waitH3Entered(ctx, p.entered); err != nil {
+		return fmt.Errorf("http3: wait for caller-deadline request: %w", err)
+	}
+	addr := p.srv.BoundUDPAddrForTest()
+	stopCtx, cancel := context.WithTimeout(ctx, 300*time.Millisecond)
+	defer cancel()
+	started := time.Now()
+	err := p.srv.Stop(stopCtx)
+	elapsed := time.Since(started)
+	if err == nil {
+		return errors.New("http3: Stop past the caller deadline reported success")
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		return fmt.Errorf("http3: Stop did not retain the caller deadline: %w", err)
+	}
+	if elapsed > 1500*time.Millisecond {
+		return fmt.Errorf("http3: Stop blocked %v past the 300ms caller deadline", elapsed)
+	}
+	if errors.Is(err, http3.ErrH3Shutdown) {
+		return fmt.Errorf("http3: caller cancellation included unfinished shutdown fault: %w", err)
+	}
+	rebound, berr := net.ListenPacket("udp", addr)
+	if berr != nil {
+		return fmt.Errorf("http3: UDP port %s stayed bound after caller-deadline Stop: %w", addr, berr)
+	}
+	if cerr := rebound.Close(); cerr != nil {
+		return fmt.Errorf("http3: close rebound UDP port: %w", cerr)
+	}
+	if err := waitH3Entered(ctx, packet.entered); err != nil {
+		return fmt.Errorf("http3: UDP reader did not observe socket closure: %w", err)
+	}
+	select {
+	case <-packet.exited:
+		return errors.New("http3: UDP reader escaped the cleanup barrier")
+	default:
+	}
+	packet.release()
+	if err := waitH3Entered(ctx, packet.exited); err != nil {
+		return fmt.Errorf("http3: UDP reader did not exit after release: %w", err)
+	}
+	return nil
+}
+
+func TestH3StopReturnsWhileTransportCleanupBlocked(t *testing.T) {
+	cert, pool := testCert(t)
+	if pool == nil {
+		t.Fatal("cert pool missing")
+		return
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+	listener, packet := bindH3CallerSockets(t)
+	hold, release := context.WithCancel(ctx)
+	held := &heldClosedPacketReader{PacketConn: packet, hold: hold, release: release, entered: make(chan struct{}), exited: make(chan struct{})}
+	entered := make(chan struct{})
+	router := web.NewRouter()
+	router.Handle("GET", "/sync", syncHandler(entered))
+	server := &http3.Server{Router: router, TLS: &tls.Config{Certificates: []tls.Certificate{cert}}, H3: true, ShutdownGrace: 5 * time.Second}
+	t.Cleanup(func() {
+		held.release()
+		stopH3Server(t, server)
+		closeH3CallerSockets(t, listener, packet)
+	})
+	if err := server.Serve(ctx, listener, held); err != nil {
+		t.Fatalf("serve caller sockets: %v", err)
+		return
+	}
+	tr := http3peer.NewTransport(&tls.Config{RootCAs: pool})
+	defer closeH3Transport(t, tr)
+	p := &deadlineProbe{entered: entered, tr: tr, url: "https://" + packet.LocalAddr().String() + "/sync", srv: server}
+	fetchCtx, endFetch := context.WithCancel(ctx)
+	defer endFetch()
+	if err := func() error {
+		go group (ctx) {
+			go fetchSyncDeadline(fetchCtx, p)
+			go stopWithPacketReaderHeld(ctx, p, held, endFetch)
+		}
+		return nil
+	}(); err != nil {
+		t.Fatal(err)
+	}
+}
