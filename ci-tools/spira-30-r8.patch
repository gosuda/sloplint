-	}
-	const fallback = 5 * time.Second
-	waitCtx, cancel := context.WithTimeout(ctx, fallback)
-	defer cancel()
-	stopErr := waitH3Entered(waitCtx, p.stopped)
-	close(p.release)
-	exitErr := waitH3Entered(ctx, p.exited)
-	if stopErr != nil {
-		return fmt.Errorf("Stop still waiting after %v with the HTTP/3 handler held: %w", fallback, stopErr)
-	}
-	if exitErr != nil {
-		return fmt.Errorf("HTTP/3 handler did not exit after release: %w", exitErr)
-	}
-	return nil
-}
