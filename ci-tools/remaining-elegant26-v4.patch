+name: "verify"
+
+on:
+  schedule:
+    - cron: '41 4 * * 1'
+  workflow_dispatch:
+
+permissions:
+  contents: "read"
+
+concurrency:
+  group: "verify-${{ github.ref }}"
+  cancel-in-progress: true
+
+defaults:
+  run:
+    shell: "bash"
+
+jobs:
+  build:
+    runs-on: "depot-ubuntu-24.04-8"
+    timeout-minutes: 20
+    env:
+      CARGO_BUILD_JOBS: "2"
+    steps:
+      - name: "Checkout"
+        uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1" # v7.0.1
+        with:
+          persist-credentials: false
+      - name: "Set up Go"
+        uses: "actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e" # v7.0.0
+        with:
+          go-version-file: "go.mod"
+          cache: true
+      - name: "Install the Rust toolchain"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          rustup toolchain install
+      - name: "Cache the Rust build"
+        uses: "Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0" # v2.9.3
+      - name: "Install just"
+        uses: "taiki-e/install-action@cfdb7ed4ccc7c7dce37759eae89dc5674b469b39" # v2.90.3
+        with:
+          tool: "just@1.59.0"
+      - name: "Build both engines"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          just build
+      - name: "Stage the native engines"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          mkdir -p dist-engines
+          cp bin/emd-go bin/emd-rs dist-engines/
+          ./dist-engines/emd-go --version
+          ./dist-engines/emd-rs --version
+      - name: "Upload the native engines"
+        uses: "actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f" # v7.0.0
+        with:
+          name: "native-engines"
+          path: |
+            dist-engines/emd-go
+            dist-engines/emd-rs
+          if-no-files-found: "error"
+          retention-days: 7
+
+  references:
+    runs-on: "depot-ubuntu-24.04-8"
+    timeout-minutes: 90
+    needs: "build"
+    if: "!cancelled()"
+    env:
+      CARGO_BUILD_JOBS: "2"
+      LEAN_NUM_THREADS: "2"
+    steps:
+      - name: "Checkout"
+        uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1" # v7.0.1
+        with:
+          persist-credentials: false
+      - name: "Set up Go"
+        uses: "actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e" # v7.0.0
+        with:
+          go-version-file: "go.mod"
+          cache: true
+      - name: "Install the Rust toolchain"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          rustup toolchain install
+      - name: "Cache the Rust build"
+        uses: "Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0" # v2.9.3
+      - name: "Install gate tools"
+        id: "tools"
+        uses: "taiki-e/install-action@cfdb7ed4ccc7c7dce37759eae89dc5674b469b39" # v2.90.3
+        with:
+          tool: "just@1.59.0,cargo-nextest@0.9.151,cargo-deny@0.20.2,jaq@3.2.0"
+      - name: "Download the native engines"
+        id: "engines-download"
+        if: "!cancelled() && needs.build.result == 'success' && steps.tools.outcome == 'success'"
+        uses: "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333" # v8.0.2
+        with:
+          name: "native-engines"
+          path: "dist-engines"
+      - name: "Check the native engines"
+        id: "engines"
+        if: "!cancelled() && steps.engines-download.outcome == 'success'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          mkdir -p bin
+          cp dist-engines/emd-go dist-engines/emd-rs bin/
+          chmod +x bin/emd-go bin/emd-rs
+          test -x bin/emd-go
+          test -x bin/emd-rs
+          bin/emd-go --version
+          bin/emd-rs --version
+      - name: "Check generated files"
+        if: "!cancelled() && steps.tools.outcome == 'success'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          just gen-check
+      - name: "Run the Go gates"
+        if: "!cancelled() && steps.engines.outcome == 'success'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          just --no-deps go-check
+      - name: "Run the Rust gates"
+        if: "!cancelled() && steps.engines.outcome == 'success'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          just --no-deps rust-check
+      - name: "Restore the pinned Lean toolchain"
+        id: "lean-cache"
+        if: "!cancelled() && steps.tools.outcome == 'success'"
+        uses: "actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9" # v6.1.0
+        with:
+          path: "~/.cache/lean"
+          key: "lean-${{ hashFiles('proofs/lean-toolchain') }}"
+      - name: "Install the pinned Lean toolchain"
+        id: "lean-install"
+        if: "!cancelled() && steps.tools.outcome == 'success' && steps.lean-cache.outputs.cache-hit != 'true'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          test "$(cat proofs/lean-toolchain)" = "leanprover/lean4:v4.35.0"
+          curl --fail --location --retry 3 --output "$RUNNER_TEMP/lean.tar.zst" \
+            "https://github.com/leanprover/lean4/releases/download/v4.35.0/lean-4.35.0-linux.tar.zst"
+          echo "7289597a44543246c9227b8cae501767e095ce17f6d448b95fc4a8dc97268f6d  $RUNNER_TEMP/lean.tar.zst" | sha256sum --check
+          mkdir -p "$HOME/.cache/lean"
+          tar --zstd -xf "$RUNNER_TEMP/lean.tar.zst" --strip-components=1 -C "$HOME/.cache/lean"
+      - name: "Add the Lean toolchain to PATH"
+        id: "lean"
+        if: "!cancelled() && steps.tools.outcome == 'success'"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
