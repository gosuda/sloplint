-                directory.push(component.as_os_str());
-                directory = directory.canonicalize()?;
-            }
-            Component::CurDir => {}
-            Component::ParentDir => {
-                directory.pop();
-            }
-            Component::Normal(name) => {
-                directory.push(name);
