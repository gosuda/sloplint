+    }
+
+    #[test]
+    fn directory_resolution_allows_missing_directories_but_rejects_files() -> std::io::Result<()> {
+        let directory = TestDir::new()?;
+        // PathBuf::join removes parent components after a verbatim Windows prefix.
+        // Preserve the fixture components so the resolver must inspect them.
+        let unresolved = |suffix: &str| {
+            let mut path = directory.0.as_os_str().to_os_string();
+            path.push(std::path::MAIN_SEPARATOR_STR);
+            path.push(suffix.replace('/', std::path::MAIN_SEPARATOR_STR));
+            PathBuf::from(path)
+        };
+        assert_eq!(
+            resolved_directory(&unresolved("missing/../images"))?,
+            directory.0.join("images")
+        );
+        assert!(!directory.0.join("missing").exists());
+        std::fs::write(directory.0.join("file"), b"sentinel")?;
+        assert_eq!(
+            resolved_directory(&unresolved("file/../images")).map_err(|error| error.kind()),
+            Err(std::io::ErrorKind::NotADirectory)
+        );
+        Ok(())
+    }
