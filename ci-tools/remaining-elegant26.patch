+        with:
+          node-version: "26.13.1"
+          cache: "pnpm"
+          cache-dependency-path: "playground/pnpm-lock.yaml"
+      - name: "Install playground packages"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          pnpm --dir playground install --frozen-lockfile
+      - name: "Build the WebAssembly engines"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          just playground-wasm
+      - name: "Render the sample output"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          just playground-sample
+      - name: "Build the site"
+        run: |
+          export GOENV=off GOCACHEPROG=''
+          test -z "$(go env GOCACHEPROG)"
+          BASE_PATH=/elegant-mermaid just playground-build
+      - name: "Configure Pages"
+        uses: "actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d" # v6.0.0
+      - name: "Upload the site artifact"
+        uses: "actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9" # v5.0.0
+        with:
+          path: "playground/build"
+
+  deploy:
+    runs-on: "depot-ubuntu-24.04"
+    needs: "build"
+    environment:
+      name: "github-pages"
+    steps:
+      - name: "Deploy to Pages"
+        uses: "actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346" # v5.0.1
