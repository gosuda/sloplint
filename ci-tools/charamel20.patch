diff --git a/bin/crush/lib/shell_screen.mli b/bin/crush/lib/shell_screen.mli
index 3806eaa..73f36cf 100644
--- a/bin/crush/lib/shell_screen.mli
+++ b/bin/crush/lib/shell_screen.mli
@@ -40,3 +40,8 @@ val platform : dialect
 val screen : dialect -> string -> verdict
 (** [screen dialect command] classifies [command]. {!Blocked} takes precedence over
     {!Review}, and a command that fails to parse is {!Review} unless it is {!Blocked}. *)
+
+val fd_executes : string list -> bool
+(** [fd_executes args] recognizes execution actions in literal [fd] arguments that have
+    already passed {!screen} as {!Clear}. Known data operands and arguments after [--]
+    are not options. The argument list excludes the program name. *)
diff --git a/bin/crush/lib/tools_shell.ml b/bin/crush/lib/tools_shell.ml
index 7ffa1f1..508df0d 100644
--- a/bin/crush/lib/tools_shell.ml
+++ b/bin/crush/lib/tools_shell.ml
@@ -94,7 +94,7 @@ let safe_simple_command command args =
       "printenv";
     ]
   in
-  if command = "fd" then not (has_option_prefix [ "--exec"; "-x"; "-X" ] args)
+  if command = "fd" then not (Shell_screen.fd_executes args)
   else if command = "rg" then not (has_option_prefix [ "--pre"; "--pre-glob" ] args)
   else List.mem command safe || (command = "env" && args = [])
 
