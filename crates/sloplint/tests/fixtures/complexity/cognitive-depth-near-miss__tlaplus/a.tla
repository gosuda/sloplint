---- MODULE CogNear ----
Op(a) ==
    \E x \in {1, 2} :
        /\ IF a = 1 THEN TRUE ELSE FALSE
        /\ IF a = 2 THEN TRUE ELSE FALSE
        /\ IF a = 3 THEN TRUE ELSE FALSE
        /\ IF a = 4 THEN TRUE ELSE FALSE
        /\ IF a = 5 THEN TRUE ELSE FALSE
        /\ IF a = 6 THEN TRUE ELSE FALSE
        /\ IF a = 7 THEN TRUE ELSE FALSE
        /\ IF a = 8 THEN TRUE ELSE FALSE
        /\ IF a = 9 THEN TRUE ELSE FALSE
        /\ IF a = 10 THEN TRUE ELSE FALSE
====
