module Loop {
  method Accumulate(n: int) returns (total: int)
  {
    var i := 0;
    total := 0;
    var p01 := 1;
    var p02 := 2;
    var p03 := 3;
    var p04 := 4;
    var p05 := 5;
    var p06 := 6;
    var p07 := 7;
    var p08 := 8;
    var p09 := 9;
    i := i + 1;
    total := total + i;
    var q10 := 10;
    var q11 := 11;
    var q12 := 12;
    var q13 := 13;
    var q14 := 14;
    var q15 := 15;
    var q16 := 16;
    var q17 := 17;
    var q18 := 18;
    var q19 := 19;
    var q20 := 20;
    var q21 := 21;
    var q22 := 22;
    var q23 := 23;
    var q24 := 24;
    var q25 := 25;
    i := i + n;
    total := total + i;
  }
}
