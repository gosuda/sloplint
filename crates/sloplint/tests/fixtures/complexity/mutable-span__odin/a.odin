package probe

stretch_assign :: proc(seed: int) -> int {
    scratch: int = seed
    scratch += 1
    scratch += 2
    scratch += 3
    scratch += 4
    scratch += 5
    scratch += 6
    scratch += 7
    scratch += 8
    scratch += 9
    scratch += 10
    scratch += 11
    scratch += 12
    scratch += 13
    scratch += 14
    scratch += 15
    scratch += 16
    scratch += 17
    scratch += 18
    return scratch
}
