+// Consumes the newline that ends a heredoc body only when the next non-blank
+// line is the closing identifier. The lookahead past the newline is never
+// part of the token: `mark_end` is set right after the newline.
+static bool scan_heredoc_final_newline(Scanner *scanner, TSLexer *lexer) {
+    if (scanner->heredocs.size == 0) {
+        return false;
+    }
+    if (lexer->lookahead == '\r') {
+        advance(lexer);
+        if (lexer->lookahead == '\n') {
+            advance(lexer);
+        }
+    } else if (lexer->lookahead == '\n') {
+        advance(lexer);
+    } else {
+        return false;
+    }
+    lexer->mark_end(lexer);
+
+    while (iswspace(lexer->lookahead)) {
+        advance(lexer);
+    }
+    String word = scan_heredoc_word(lexer);
+    bool matches = string_eq(&word, &array_back(&scanner->heredocs)->word);
+    array_delete(&word);
+    return matches;
+}
