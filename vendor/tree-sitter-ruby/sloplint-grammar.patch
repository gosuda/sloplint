+static inline bool scan_block_marker_word(TSLexer *lexer, const char *word) {
+    for (const char *p = word; *p != '\0'; p++) {
+        if (lexer->lookahead != *p) {
+            return false;
+        }
+        advance(lexer);
+    }
+    return !is_block_word_char(lexer->lookahead);
+}
