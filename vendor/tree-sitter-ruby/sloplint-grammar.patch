+// A `=begin ... =end` comment. It starts only when `=begin` is the first
+// text of a line. It ends at the first later line that starts with `=end`
+// followed by whitespace or the end of the input; trailing text on the
+// `=end` line is part of the comment. Any other line, including one that
+// starts with `=endx`, is ordinary content.
+static inline bool is_block_word_char(int32_t c) {
+    return c != 0 && (c == '_' || iswalnum(c));
+}
