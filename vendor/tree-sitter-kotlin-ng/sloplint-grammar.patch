+                    skip_string(lexer, ch);
+                    continue;
+                }
+                if (ch == '/') {
+                    skip(lexer);
+                    if (lexer->lookahead == '/') {
+                        while (lexer->lookahead != '\n' && !lexer->eof(lexer)) {
+                            skip(lexer);
+                        }
+                        continue;
+                    }
+                    if (lexer->lookahead == '*') {
+                        skip(lexer);
+                        unsigned comment_depth = 1;
+                        while (comment_depth > 0 && !lexer->eof(lexer)) {
+                            wchar_t c = lexer->lookahead;
+                            skip(lexer);
+                            if (c == '/' && lexer->lookahead == '*') {
+                                comment_depth++;
+                                skip(lexer);
+                            } else if (c == '*' && lexer->lookahead == '/') {
+                                comment_depth--;
+                                skip(lexer);
+                            }
+                        }
+                        continue;
+                    }
+                    continue;
+                }
+                if (ch == '(') {
+                    depth++;
+                } else if (ch == ')') {
