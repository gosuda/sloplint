+        if (lexer->lookahead != '/') {
+            return comment;
+        }
+        skip(lexer);
+        if (lexer->lookahead == '/') {
+            while (lexer->lookahead != '\n' && !lexer->eof(lexer)) {
+                skip(lexer);
+            }
+            comment = true;
+            continue;
+        }
+        if (lexer->lookahead != '*') {
+            return comment;
+        }
+        comment = true;
