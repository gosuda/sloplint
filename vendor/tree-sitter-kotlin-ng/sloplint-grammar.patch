+static bool get_call_follows(TSLexer *lexer) {
+    if (lexer->lookahead != '(') {
+        return false;
+    }
+    skip(lexer);
+    while (iswspace(lexer->lookahead)) {
+        skip(lexer);
+    }
+    return lexer->lookahead != ')';
