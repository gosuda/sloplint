+            wchar_t c = lexer->lookahead;
+            skip(lexer);
+            if (c == '/' && lexer->lookahead == '*') {
+                depth++;
+                skip(lexer);
+            } else if (c == '*' && lexer->lookahead == '/') {
+                depth--;
+                skip(lexer);
+            }
